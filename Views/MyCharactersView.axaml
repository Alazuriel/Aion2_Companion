<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AION_2_Companion.ViewModels"
             xmlns:characters="using:AION_2_Companion.Core.Characters"
             xmlns:controls="using:AION_2_Companion.Views.Controls"
             x:Class="AION_2_Companion.Views.MyCharactersView"
             x:DataType="vm:MyCharactersViewModel" Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" MaxWidth="1080" Margin="0,0,8,28">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource CharacterCenterKicker}" Classes="kicker"/>
          <TextBlock Text="{DynamicResource CharacterCenterTitle}" Classes="h1" FontSize="29"/>
          <TextBlock Text="{DynamicResource CharacterCenterSubtitle}" Classes="body"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ui primary" Content="{DynamicResource CharacterSelfTab}" IsEnabled="False"/>
          <Button Classes="ui" Content="{DynamicResource CharacterSearchTab}" Click="OpenSearchClick"/>
        </StackPanel>
      </Grid>

      <Border Classes="hero" Padding="20">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource UiMyCharactersVerifiedCharacters}" Classes="kicker" Foreground="#45DFFF"/>
              <TextBlock Text="{DynamicResource UiMyCharactersCharactersLinkedNexforgeAccount}" Classes="body"/>
              <TextBlock Text="{DynamicResource UiMyCharactersVerificationConfirmsCharacterControlNotOfficialNcsoftA}"
                         Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ui" Content="{DynamicResource UiMyCharactersSync}" Command="{Binding SyncVerifiedCharactersCommand}"
                    IsEnabled="{Binding CanSyncVerifiedCharacters}" VerticalAlignment="Center" MinWidth="96"/>
          </Grid>
          <TextBlock Text="{Binding VerifiedStatusText}" Classes="hint" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding VerifiedCharacters}" IsVisible="{Binding HasVerifiedCharacters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="characters:VerifiedCharacterSummary">
                <Border Classes="card" Padding="12" Margin="0,0,0,7">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="{Binding DisplayLocation}" Classes="mono" FontSize="11"/>
                      <TextBlock Text="{Binding VerificationLabel}" Classes="hint" Foreground="#45DFFF"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ui" Content="{DynamicResource UiMyCharactersSelect}" Tag="{Binding}"
                            Click="SelectVerifiedCharacterClick" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="hero" Padding="28" IsVisible="{Binding HasNoCharacter}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
          <controls:ForgeIconView Width="78" Height="78" TooltipText="{DynamicResource NoCharacterText}"/>
          <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
            <Border Classes="goldPill" HorizontalAlignment="Left"><TextBlock Text="{DynamicResource CharacterManualSelection}" Classes="kicker" FontSize="9"/></Border>
            <TextBlock Text="{DynamicResource NoCharacterTitle}" Classes="h1" FontSize="23"/>
            <TextBlock Text="{DynamicResource NoCharacterText}" Classes="body" TextWrapping="Wrap"/>
            <Button Classes="ui primary" Content="{DynamicResource CharacterFindManually}" Click="OpenSearchClick" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="hero" Padding="24" IsVisible="{Binding HasCharacter}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
          <controls:ForgeIconView Width="88" Height="88" IconSource="{Binding ProfileImageUrl}" TooltipText="{Binding CharacterTooltip}" AccentColor="#45DFFF"/>
          <StackPanel Grid.Column="1" Spacing="7">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="{Binding Name}" Classes="h1" FontSize="26"/>
              <Border Classes="pill"><TextBlock Text="{DynamicResource CharacterSelfTab}" Classes="kicker" FontSize="8"/></Border>
            </StackPanel>
            <TextBlock Text="{Binding ClassName}" FontSize="16" Foreground="#45DFFF" FontWeight="SemiBold"/>
            <WrapPanel>
              <Border Classes="pill" Margin="0,0,7,7"><TextBlock Text="{Binding LevelText}" Classes="body"/></Border>
              <Border Classes="pill" Margin="0,0,7,7"><TextBlock Text="{Binding GearScoreText}" Classes="body"/></Border>
              <Border Classes="pill" Margin="0,0,7,7"><TextBlock Text="{Binding ServerText}" Classes="body"/></Border>
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" Classes="hint" IsVisible="{Binding HasStatus}"/>
            <TextBlock Text="{Binding DetectedText}" Classes="mono" FontSize="10" Foreground="#647D93"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
            <Button Classes="ui primary" Content="{DynamicResource ViewCharacter}" Click="OpenCharacterClick" MinWidth="160"/>
            <Button Classes="ui" Content="{Binding VerificationBadge}" Click="VerifyCharacterClick" IsEnabled="{Binding CanVerify}" MinWidth="160"/>
            <Button Classes="ui" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" MinWidth="160"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
