<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AION_2_Companion.Views"
             x:Class="AION_2_Companion.Views.LeaderboardsView"
             Background="Transparent">
  <Grid>
    <views:UnderForgeView x:Name="UnderForgeContent"/>
    <ScrollViewer x:Name="DeveloperContent" IsVisible="False" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18" MaxWidth="1080" Margin="0,0,8,28">
        <StackPanel Spacing="4"><TextBlock Text="{DynamicResource LeaderboardsKicker}" Classes="kicker"/><TextBlock Text="{DynamicResource LeaderboardsTitle}" Classes="h1" FontSize="29"/><TextBlock Text="{DynamicResource LeaderboardsSubtitle}" Classes="body"/></StackPanel>
        <Border Classes="hero" Padding="18"><WrapPanel><ComboBox Width="200" IsEnabled="False" Margin="0,0,10,0"/><ComboBox Width="200" IsEnabled="False" Margin="0,0,10,0"/><ComboBox Width="200" IsEnabled="False"/></WrapPanel></Border>
        <Border Classes="panel" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="54,1.3*,1.2*,120,150" ColumnSpacing="10"><TextBlock Text="#" Classes="kicker"/><TextBlock Grid.Column="1" Text="{DynamicResource LeaderboardPlayer}" Classes="kicker"/><TextBlock Grid.Column="2" Text="{DynamicResource LeaderboardBoss}" Classes="kicker"/><TextBlock Grid.Column="3" Text="{DynamicResource LeaderboardDps}" Classes="kicker"/><TextBlock Grid.Column="4" Text="{DynamicResource LeaderboardServer}" Classes="kicker"/></Grid>
            <Border Classes="rowline"/>
            <StackPanel Spacing="8" Margin="0,38"><Border Classes="goldPill" HorizontalAlignment="Center"><TextBlock Text="{DynamicResource StillUnderForge}" Classes="kicker" FontSize="9"/></Border><TextBlock Text="{DynamicResource LeaderboardsNotAvailable}" Classes="body" TextAlignment="Center"/></StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
