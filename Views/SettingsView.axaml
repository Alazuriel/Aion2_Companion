<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AION_2_Companion.Views.SettingsView"
             Background="Transparent"
             Foreground="#EAF7FF">
  <UserControl.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Settings.axaml"/>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch" Margin="0,0,8,28">

      <Border CornerRadius="20" BorderBrush="#466782" BorderThickness="1" Padding="22"
              BoxShadow="0 18 44 0 #60000000">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E90A1726" Offset="0"/>
            <GradientStop Color="#D8102132" Offset="0.64"/>
            <GradientStop Color="#DD211C1C" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <Border Width="54" Height="54" CornerRadius="15" Background="#A30A1422"
                  BorderBrush="#657D91" BorderThickness="1" BoxShadow="0 0 25 0 #4845DFFF">
            <Image Source="/Assets/nexforge-companion-icon.png" Margin="2" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource SettingsKicker}" Classes="kicker"/>
            <TextBlock Text="{DynamicResource SettingsHeroTitle}" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource SettingsHeroSubtitle}" Classes="body" MaxWidth="650"/>
          </StackPanel>
          <Border Grid.Column="2" Classes="settings-status gold" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="7" Height="7" Fill="#D8B96A" VerticalAlignment="Center"/>
              <TextBlock x:Name="VersionText" Classes="mono" FontSize="11" Foreground="#F0D99F"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8">
            <TextBlock Text="01 // GENERAL" Classes="settings-index"/>
            <TextBlock Text="{DynamicResource GeneralCategory}" Classes="settings-category"/>
            <TextBlock Text="{DynamicResource GeneralCategoryHint}" Classes="hint"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource LanguageLabel}" Classes="settings-label"/><TextBlock Text="{DynamicResource LanguageHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Classes="settings-select"/>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="7">
                <StackPanel Spacing="3">
                  <TextBlock Text="{DynamicResource CommunityLanguageTitle}" Classes="settings-label"/>
                  <TextBlock Text="{DynamicResource CommunityLanguageHint}" Classes="hint"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="ui" Content="{DynamicResource ImportLanguage}" Click="ImportLanguageClick"/>
                  <Button Classes="ui quiet" Content="{DynamicResource OpenLanguageFolder}" Click="OpenLanguageFolderClick"/>
                </StackPanel>
                <TextBlock x:Name="LanguageImportStatus" Grid.Row="1" Grid.ColumnSpan="2" Classes="hint"
                           Foreground="#74D9F5" IsVisible="False" TextWrapping="Wrap"/>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource CloseBehavior}" Classes="settings-label"/><TextBlock Text="{DynamicResource CloseBehaviorHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="CloseActionCombo" Grid.Column="1" Classes="settings-select">
                  <ComboBoxItem Content="{DynamicResource CloseAsk}" Tag="0"/><ComboBoxItem Content="{DynamicResource CloseTray}" Tag="1"/><ComboBoxItem Content="{DynamicResource CloseExit}" Tag="2"/>
                </ComboBox>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource TutorialSettingTitle}" Classes="settings-label"/><TextBlock Text="{DynamicResource TutorialSettingHint}" Classes="hint"/></StackPanel>
                <Button Grid.Column="1" Classes="ui" Content="{DynamicResource RestartTutorial}" Click="RestartTutorialClick" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource NexforgeLinkTitle}" Classes="settings-label"/><TextBlock Text="{DynamicResource NexforgeLinkHint}" Classes="hint"/></StackPanel>
                <Button Grid.Column="1" Classes="ui" Content="{DynamicResource OpenNexforge}" Click="OpenNexforgeClick" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8">
            <TextBlock Text="02 // MONITORING" Classes="settings-index"/>
            <TextBlock Text="{DynamicResource CaptureCategory}" Classes="settings-category"/>
            <TextBlock Text="{DynamicResource CaptureCategoryHint}" Classes="hint"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row">
              <StackPanel Spacing="4"><CheckBox x:Name="AutoCaptureToggle" Content="{DynamicResource AutoCapture}"/><TextBlock Text="{DynamicResource AutoCaptureHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource MapHelper}" Classes="settings-label"/><TextBlock Text="{DynamicResource MapHelperHint}" Classes="hint"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="ui quiet" Content="i" Width="30" Height="30" FontSize="13" ToolTip.Tip="{DynamicResource MapHelperTooltip}"/>
                  <CheckBox x:Name="MapHelperToggle" Content="{DynamicResource Enabled}"/>
                </StackPanel>
                <Border x:Name="MapAdminWarning" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" Margin="0,11,0,0" Padding="11,9" CornerRadius="9" Background="#24F59E0B" BorderBrush="#88F59E0B" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="9"><Border Width="20" Height="20" CornerRadius="10" Background="#F59E0B"><TextBlock Text="!" Foreground="#17120A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{DynamicResource MapAdminWarning}" Foreground="#FBBF24" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="03 // COMBAT" Classes="settings-index"/><TextBlock Text="{DynamicResource CombatCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource CombatCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><StackPanel Spacing="4"><CheckBox x:Name="AutoDpsOverlayToggle" Content="{DynamicResource AutoDps}"/><TextBlock Text="{DynamicResource AutoDpsHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel></Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource DpsEncounterScope}" Classes="settings-label"/><TextBlock Text="{DynamicResource DpsEncounterScopeHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="DpsEncounterModeCombo" Grid.Column="1" Classes="settings-select"><ComboBoxItem Content="{DynamicResource EncounterModeAll}" Tag="0"/><ComboBoxItem Content="{DynamicResource EncounterModeBosses}" Tag="1"/></ComboBox>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource SavedFights}" Classes="settings-label"/><TextBlock Text="{DynamicResource SavedFightsHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="CombatLogLimitCombo" Grid.Column="1" Classes="settings-select"><ComboBoxItem Content="{DynamicResource Fights100}" Tag="100"/><ComboBoxItem Content="{DynamicResource Fights500}" Tag="500"/><ComboBoxItem Content="{DynamicResource Fights1000}" Tag="1000"/><ComboBoxItem Content="{DynamicResource Unlimited}" Tag="0"/></ComboBox>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="04 // OVERLAY" Classes="settings-index"/><TextBlock Text="{DynamicResource OverlayCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource OverlayCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource DpsMeter}" Classes="settings-label"/><TextBlock Text="{DynamicResource DpsOverlayHint}" Classes="hint"/></StackPanel><Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenDpsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource BossAssistant}" Classes="settings-label"/><TextBlock Text="{DynamicResource BossOverlayHint}" Classes="hint"/></StackPanel><Border Grid.Column="1" Classes="settings-status gold" VerticalAlignment="Center"><TextBlock Text="{DynamicResource StillUnderForge}" Classes="kicker" FontSize="9" Foreground="#D8B96A"/></Border></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="05 // TIMERS" Classes="settings-index"/><TextBlock Text="{DynamicResource TimersCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource TimersCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource EventTimerRegionLabel}" Classes="settings-label"/><TextBlock Text="{DynamicResource EventTimerRegionHint}" Classes="hint"/></StackPanel><ComboBox x:Name="EventTimerRegionCombo" Grid.Column="1" Classes="settings-select"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource EventTimerOverlayTitle}" Classes="settings-label"/><TextBlock Text="{DynamicResource EventTimerOverlaySettingsHint}" Classes="hint"/><CheckBox x:Name="EventTimerClickThroughToggle" Content="{DynamicResource EventTimerClickThrough}"/></StackPanel><Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenEventTimerOverlayClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="06 // DATA &amp; UPDATES" Classes="settings-index"/><TextBlock Text="{DynamicResource ForgeDataCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource ForgeDataCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Ellipse x:Name="ForgeDataStatusDot" Width="8" Height="8" Fill="#58E0B2" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{DynamicResource ForgeDataRuntimeTitle}" Classes="settings-label"/><TextBlock x:Name="ForgeDataStatusText" Classes="hint"/><TextBlock x:Name="ForgeDataPathText" Classes="mono" FontSize="10" Foreground="#5F7488" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Border Grid.Column="2" Classes="settings-status" VerticalAlignment="Center"><TextBlock Text="{DynamicResource LocalDataBadge}" Classes="kicker" FontSize="9"/></Border>
              </Grid>
            </Border>
            <Border Classes="settings-row"><StackPanel Spacing="4"><CheckBox x:Name="AutoUpdateToggle" Content="{DynamicResource AutoUpdateToggle}"/><TextBlock Text="{DynamicResource AutoUpdateHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource CurrentVersion}" Classes="settings-label"/><TextBlock x:Name="UpdateCheckStatusText" Classes="hint" TextWrapping="Wrap"/></StackPanel><Button x:Name="CheckUpdateButton" Grid.Column="1" Classes="ui" Content="{DynamicResource CheckForUpdates}" Click="CheckUpdateClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="07 // PETS" Classes="settings-index"/><TextBlock Text="{DynamicResource PetCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource PetCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource PetCollectionStatus}" Classes="settings-label"/><TextBlock Text="{DynamicResource PetStatusRuntimeHint}" Classes="hint"/></StackPanel><Border Grid.Column="1" Classes="settings-status" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="PetCollectionStatusDot" Width="7" Height="7" Fill="#FFB454" VerticalAlignment="Center"/><TextBlock x:Name="PetCollectionStatusText" Text="UNKNOWN" FontSize="10" FontWeight="SemiBold" Foreground="#FFB454"/></StackPanel></Border></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="92,*" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource PetUnknown}" Classes="kicker" FontSize="9" Foreground="#FFB454"/><TextBlock Text="{DynamicResource PetUnknownTitle}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource PetUnknownText}" Classes="hint" VerticalAlignment="Center"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="92,*" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource PetPartial}" Classes="kicker" FontSize="9"/><TextBlock Text="{DynamicResource PetPartialTitle}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource PetPartialText}" Classes="hint" VerticalAlignment="Center"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="92,*" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource PetReady}" Classes="kicker" FontSize="9" Foreground="#58E0B2"/><TextBlock Text="{DynamicResource PetReadyTitle}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource PetReadyText}" Classes="hint" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="08 // SUPPORT LOGS" Classes="settings-index"/><TextBlock Text="{DynamicResource DiagnosticsCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource DiagnosticsCategoryHint}" Classes="hint"/></StackPanel>
          <Border Grid.Column="1" Classes="settings-row"><StackPanel Spacing="5"><CheckBox x:Name="FileLoggingToggle" Content="{DynamicResource LoggingToggle}"/><TextBlock x:Name="FileLoggingHint" Classes="hint" TextWrapping="Wrap" Margin="25,0,0,0"/></StackPanel></Border>
        </Grid>
      </Border>

      <Border x:Name="DeveloperSettingsPanel" Classes="settings-card" BorderBrush="#7045DFFF">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="09 // DEBUG" Classes="settings-index"/><TextBlock Text="{DynamicResource DeveloperTools}" Classes="settings-category"/></StackPanel>
          <Border Grid.Column="1" Classes="settings-row"><StackPanel Spacing="4"><TextBlock Text="{DynamicResource DeveloperToolsHint}" Classes="body"/><TextBlock Text="{DynamicResource DeveloperModeActive}" Classes="kicker" FontSize="9"/></StackPanel></Border>
        </Grid>
      </Border>

      <Border Classes="settings-card" Padding="18,13">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="#45DFFF" VerticalAlignment="Center"/><TextBlock Text="NEXFORGE // COMPANION CONFIGURATION" Classes="kicker" FontSize="9"/></StackPanel><TextBlock Grid.Column="1" Text="UNDER FORGE" Classes="mono" FontSize="9" Foreground="#8F7845"/></Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
