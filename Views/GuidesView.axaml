<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AION_2_Companion.Views.GuidesView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource UiGuideClassGuide}" Classes="h1"/>
        <TextBlock Text="{DynamicResource UiGuideClassRolesBuildsPartyComposition}" Classes="body"/>
      </StackPanel>

      <Border Classes="panel" Padding="0">
        <StackPanel>
          <Grid ColumnDefinitions="200,*,Auto" Margin="18,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#9EB8C4" VerticalAlignment="Center"/>
              <TextBlock Text="Assassin" Classes="accent" FontWeight="Medium"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3" Margin="8,0">
              <TextBlock Text="{DynamicResource UiGuideBurstSingleTarget}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource UiGuideUptimeCleanBurstWindowsTargetAccess}" Classes="body" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="ui" Content="{DynamicResource UiGuideNotes}" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="rowline"/>
          <Grid ColumnDefinitions="200,*,Auto" Margin="18,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#9EB8C4" VerticalAlignment="Center"/>
              <TextBlock Text="Aether Sorcerer" Classes="accent" FontWeight="Medium"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3" Margin="8,0">
              <TextBlock Text="{DynamicResource UiGuideMagicRanged}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource UiGuideSpaceRotationsBuildsCommunityBuildsWillBeAddedLater}" Classes="body" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="ui" Content="{DynamicResource UiGuideNotes}" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="rowline"/>
          <Grid ColumnDefinitions="200,*,Auto" Margin="18,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#9EB8C4" VerticalAlignment="Center"/>
              <TextBlock Text="Templar" Classes="accent" FontWeight="Medium"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3" Margin="8,0">
              <TextBlock Text="{DynamicResource UiGuideFrontlineDefense}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource UiGuideRoleGearPrioritiesEncounterNotes}" Classes="body" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="ui" Content="{DynamicResource UiGuideNotes}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource UiGuidePartyComposition}" Classes="section"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource UiGuideSample}" Classes="eyebrow" VerticalAlignment="Center"/>
          </Grid>
          <WrapPanel Orientation="Horizontal">
            <Border Classes="pill" Margin="0,0,8,8"><TextBlock Text="Assassin" Classes="accent" FontSize="13"/></Border>
            <Border Classes="pill" Margin="0,0,8,8"><TextBlock Text="Shadow Ranger" Classes="accent" FontSize="13"/></Border>
            <Border Classes="pill" Margin="0,0,8,8"><TextBlock Text="Aether Sorcerer" Classes="accent" FontSize="13"/></Border>
            <Border Classes="pill" Margin="0,0,8,8"><TextBlock Text="Templar" Classes="accent" FontSize="13"/></Border>
            <Border Classes="pill" Margin="0,0,8,8"><TextBlock Text="Cleric" Classes="accent" FontSize="13"/></Border>
          </WrapPanel>
          <TextBlock Text="{DynamicResource PartyGuideHint}" Classes="hint"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
