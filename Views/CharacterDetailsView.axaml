<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AION_2_Companion.ViewModels"
             xmlns:controls="using:AION_2_Companion.Views.Controls"
             xmlns:views="using:AION_2_Companion.Views"
             xmlns:accounts="using:AION_2_Companion.Core.Accounts"
             x:Class="AION_2_Companion.Views.CharacterDetailsView"
             x:DataType="vm:CharacterDetailsViewModel"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="#7890A6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="15,10"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#45DFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" MaxWidth="1120" Margin="0,0,8,28">
        <Button Classes="ui quiet" HorizontalAlignment="Left" Click="BackClick">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="←"/><TextBlock Text="{DynamicResource BackToCharacters}" FontSize="12"/></StackPanel>
        </Button>

        <StackPanel Spacing="4"><TextBlock Text="{DynamicResource CharacterDetailsKicker}" Classes="kicker"/><TextBlock Text="{DynamicResource CharacterDetailsTitle}" Classes="h1" FontSize="29"/><TextBlock Text="{DynamicResource CharacterDetailsSubtitle}" Classes="body"/></StackPanel>

        <Border Classes="hero" Padding="24" IsVisible="{Binding HasNoCharacter}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20"><controls:ForgeIconView Width="76" Height="76"/><StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center"><TextBlock Text="{DynamicResource NoCharacterTitle}" Classes="h1" FontSize="22"/><TextBlock Text="{DynamicResource NoCharacterText}" Classes="body"/></StackPanel></Grid>
        </Border>

        <Border Classes="hero" Padding="24" IsVisible="{Binding HasCharacter}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
            <controls:ForgeIconView Width="94" Height="94" IconSource="{Binding ClassIconSource}" TooltipText="{Binding ClassTooltip}" AccentColor="#45DFFF" IsSelected="True"/>
            <StackPanel Grid.Column="1" Spacing="7">
              <StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="{Binding CharacterName}" Classes="h1" FontSize="29"/>
<Border Width="24" Height="24" MinWidth="24" CornerRadius="12"
        VerticalAlignment="Center" Padding="2" ClipToBounds="True"
        Background="#132534" BorderBrush="#3B7B8E" BorderThickness="1"
        IsVisible="{Binding IsVerified}" ToolTip.Tip="Nexforge Verified">
  <Image Source="/Assets/nexforge-logo.png" Width="18" Height="18" Stretch="Uniform"/>
</Border></StackPanel>
              <TextBlock Text="{Binding CharacterClass}" Foreground="#45DFFF" FontSize="17" FontWeight="SemiBold"/>
              <WrapPanel><Border Classes="pill" Margin="0,0,7,7"><StackPanel><TextBlock Text="{DynamicResource CharacterLevel}" Classes="kicker" FontSize="8"/><TextBlock Text="{Binding LevelText}" FontSize="18"/></StackPanel></Border><Border Classes="pill" Margin="0,0,7,7"><StackPanel><TextBlock Text="{DynamicResource CharacterItemLevel}" Classes="kicker" FontSize="8"/><TextBlock Text="{Binding GearScoreText}" FontSize="18"/></StackPanel></Border><Border Classes="pill" Margin="0,0,7,7"><StackPanel><TextBlock Text="{DynamicResource LeaderboardServer}" Classes="kicker" FontSize="8"/><TextBlock Text="{Binding ServerText}" FontSize="13"/></StackPanel></Border><Border Classes="pill" Margin="0,0,7,7"><StackPanel><TextBlock Text="{DynamicResource Region}" Classes="kicker" FontSize="8"/><TextBlock Text="{Binding RegionText}" FontSize="13"/></StackPanel></Border></WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="{Binding DataStateText}" Classes="kicker"/>
              <TextBlock Text="{DynamicResource ProfileSourceHint}" Classes="hint" MaxWidth="235"/>
              <TextBlock Text="{Binding UpdatedText}" Classes="mono" FontSize="10" Foreground="#688197"/>
              <Button Classes="ui primary" Content="{Binding VerifyButtonText}" Click="VerifyCharacterClick" IsEnabled="{Binding CanVerify}"/>
              <Button Classes="ui" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"/>
              <TextBlock Text="{Binding RefreshStatus}" Classes="hint" MaxWidth="235" TextWrapping="Wrap" IsVisible="{Binding HasRefreshStatus}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="panel" Padding="8">
          <TabControl>
            <TabItem Header="{DynamicResource OverviewTab}">
              <StackPanel Spacing="16" Margin="14,18,14,14">
                <ItemsControl ItemsSource="{Binding StatCards}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CharacterStatCard"><Border Classes="inset" Width="230" Padding="16" Margin="0,0,12,12"><StackPanel Spacing="7"><TextBlock Text="{Binding Name}" Classes="kicker" FontSize="9"/><controls:MarqueeText Text="{Binding Value}" TextSize="20" TextColor="{Binding AccentColor}" IsStrong="True"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="inset" Padding="18"><StackPanel Spacing="7"><TextBlock Text="{Binding VerificationText}" Classes="kicker"/><TextBlock Text="{Binding VerificationHintText}" Classes="body" TextWrapping="Wrap"/></StackPanel></Border>
              </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource EquipmentTab}">
              <StackPanel Spacing="16" Margin="14,18,14,14">
                <ItemsControl ItemsSource="{Binding EquipmentSlots}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CharacterVisualItem"><Border Classes="inset" Width="126" Height="140" Padding="10" Margin="0,0,10,10"><Grid RowDefinitions="Auto,*,Auto"><controls:ForgeIconView Width="72" Height="72" HorizontalAlignment="Center" IconSource="{Binding IconSource}" TooltipText="{Binding Tooltip}" AccentColor="{Binding AccentColor}"/><Border HorizontalAlignment="Right" VerticalAlignment="Top" Classes="goldPill" Padding="5,2" IsVisible="{Binding HasCornerText}"><TextBlock Text="{Binding CornerText}" Classes="mono" FontSize="9"/></Border><controls:MarqueeText Grid.Row="2" Text="{Binding Name}" CenterText="True" TextSize="11" TextColor="#AFC4D5"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="ARCANA" Classes="section" FontSize="17" Foreground="#D8B96A" Margin="0,12,0,0"/>
                <ItemsControl ItemsSource="{Binding ArcanaItems}" IsVisible="{Binding HasArcanaData}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CharacterVisualItem">
                    <Border Width="132" Height="166" Classes="inset" Padding="10" Margin="0,0,12,12">
                      <Grid RowDefinitions="*,Auto">
                        <controls:ForgeIconView Width="100" Height="108" HorizontalAlignment="Center"
                                                IconSource="{Binding IconSource}" TooltipText="{Binding Tooltip}" AccentColor="{Binding AccentColor}"/>
                        <controls:MarqueeText Grid.Row="1" Text="{Binding Name}" CenterText="True" TextSize="10"/>
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding EmptyArcanaSlots}" IsVisible="{Binding HasNoArcanaData}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CharacterVisualItem">
                    <controls:ForgeIconView Width="64" Height="64" Margin="0,0,8,8" TooltipText="{Binding Tooltip}" AccentColor="{Binding AccentColor}"/>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Az Arcana-slotokat az Equipment API-ból töltjük."
                           IsVisible="{Binding HasNoArcanaData}" Classes="hint"/>
                <Border Classes="inset" Padding="17" IsVisible="{Binding HasNoEquipmentData}"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource NoItemsLoaded}" Classes="section"/><TextBlock Text="{DynamicResource EquipmentEmptyText}" Classes="body"/></StackPanel></Border>
              </StackPanel>
            </TabItem>

            <!-- NEXFORGE SKILLS-GRID-V5-APPLIED: Icon grid / hover tooltip / API skill list -->
            <TabItem Header="{DynamicResource SkillsTab}">
              <StackPanel Spacing="16" Margin="14,18,14,14">
                <!-- Only API-provided character skills are displayed. NFG enriches local art and tooltips. -->
                <ItemsControl ItemsSource="{Binding SkillItems}" IsVisible="{Binding HasSkillData}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterVisualItem">
                      <StackPanel Width="86" Margin="0,0,10,12" Spacing="5">
                        <controls:ForgeIconView Width="70" Height="70" HorizontalAlignment="Center"
                            IconSource="{Binding IconSource}" TooltipText="{Binding Tooltip}"
                            AccentColor="{Binding AccentColor}"/>
                        <controls:MarqueeText Text="{Binding Name}" CenterText="True" TextSize="10"/>
                        <TextBlock Text="{Binding CornerText}" TextAlignment="Center" Foreground="#D8B96A"
                                   FontSize="10" IsVisible="{Binding HasCornerText}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding EmptySkillSlots}" IsVisible="{Binding HasNoSkillData}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterVisualItem">
                      <controls:ForgeIconView Width="64" Height="64" Margin="0,0,10,10"
                                              TooltipText="{Binding Tooltip}" AccentColor="{Binding AccentColor}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="inset" Padding="17" IsVisible="{Binding HasNoSkillData}">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{DynamicResource NoSkillsLoaded}" Classes="section"/>
                    <TextBlock Text="{DynamicResource SkillsEmptyText}" Classes="body"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource StigmasTab}">
              <StackPanel Spacing="16" Margin="14,18,14,14"><ItemsControl ItemsSource="{Binding EmptyStigmaSlots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CharacterVisualItem"><controls:ForgeIconView Width="70" Height="70" Margin="0,0,12,12" TooltipText="{Binding Tooltip}" AccentColor="{Binding AccentColor}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Classes="inset" Padding="17"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource NoStigmasLoaded}" Classes="section"/><TextBlock Text="{DynamicResource StigmasEmptyText}" Classes="body"/></StackPanel></Border></StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource DaevanionTab}">
              <views:Characters Margin="12,16,12,16"/>
            </TabItem>

            <TabItem Header="{DynamicResource StatsTab}">
              <StackPanel Spacing="16" Margin="14,18,14,14"><ItemsControl ItemsSource="{Binding AdditionalStats}" IsVisible="{Binding HasStatsData}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="accounts:CharacterStat"><Grid ColumnDefinitions="*,Auto" Margin="4,7"><TextBlock Text="{Binding Name}" Classes="body"/><TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Classes="mono" Foreground="#45DFFF"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Classes="inset" Padding="17" IsVisible="{Binding HasNoStatsData}"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource NoStatsLoaded}" Classes="section"/><TextBlock Text="{DynamicResource StatsEmptyText}" Classes="body"/></StackPanel></Border></StackPanel>
            </TabItem>
          </TabControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
