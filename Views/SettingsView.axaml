<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AION_2_Companion.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource SettingsTitle}" Classes="h1"/>
        <TextBlock Text="{DynamicResource SettingsSubtitle}" Classes="body"/>
      </StackPanel>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource LanguageSection}" Classes="eyebrow"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource LanguageLabel}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource LanguageHint}" Classes="hint"/>
            </StackPanel>
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="210"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="0">
          <TextBlock Text="{DynamicResource OverlaySection}" Classes="eyebrow" Margin="0,0,0,6"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,10">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource DpsMeter}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource DpsOverlayHint}" Classes="hint"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenDpsClick" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="rowline" Margin="0,4"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,10">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource BossAssistant}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource BossOverlayHint}" Classes="hint"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenDbmClick" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="rowline" Margin="0,4"/>
          <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,10">
            <StackPanel Grid.Row="0" Spacing="3">
              <TextBlock Text="{DynamicResource MapHelper}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource MapHelperHint}" Classes="hint"/>
            </StackPanel>
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Classes="ui"
                    Content="i"
                    Width="32"
                    Height="32"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{DynamicResource MapHelperTooltip}"/>
            <CheckBox x:Name="MapHelperToggle"
                      Grid.Row="0"
                      Grid.Column="2"
                      Content="{DynamicResource Enabled}"
                      VerticalAlignment="Center"/>
            <Border x:Name="MapAdminWarning"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    IsVisible="False"
                    Margin="0,12,0,0"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="#1AF59E0B"
                    BorderBrush="#99F59E0B"
                    BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="20"
                        Height="20"
                        CornerRadius="10"
                        Background="#F59E0B">
                  <TextBlock Text="!"
                             Foreground="#17120A"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource MapAdminWarning}"
                           Foreground="#FBBF24"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource PetCollection}" Classes="eyebrow"/>
              <TextBlock Text="{DynamicResource PetCollectionStatus}" FontWeight="Medium" FontSize="14"/>
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="PetCollectionStatusDot" Width="7" Height="7"
                         Fill="#FFB454" VerticalAlignment="Center"/>
                <TextBlock x:Name="PetCollectionStatusText" Text="UNKNOWN"
                           FontSize="10" FontWeight="SemiBold" Foreground="#FFB454"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="inset" Padding="13,11">
            <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource PetUnknown}" Classes="kicker" FontSize="9" Foreground="#FFB454"/>
                <TextBlock Text="{DynamicResource PetUnknownTitle}" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{DynamicResource PetUnknownText}"
                         Classes="hint" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Classes="inset" Padding="13,11">
            <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource PetPartial}" Classes="kicker" FontSize="9"/>
                <TextBlock Text="{DynamicResource PetPartialTitle}" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{DynamicResource PetPartialText}"
                         Classes="hint" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Classes="inset" Padding="13,11">
            <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource PetReady}" Classes="kicker" FontSize="9" Foreground="#58E0B2"/>
                <TextBlock Text="{DynamicResource PetReadyTitle}" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{DynamicResource PetReadyText}"
                         Classes="hint" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource ApplicationSection}" Classes="eyebrow"/>
          <CheckBox x:Name="AutoCaptureToggle" Content="{DynamicResource AutoCapture}"/>
          <TextBlock Text="{DynamicResource AutoCaptureHint}" Classes="hint" Margin="24,-7,0,4"/>
          <Border Classes="rowline"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource CloseBehavior}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource CloseBehaviorHint}" Classes="hint"/>
            </StackPanel>
            <ComboBox x:Name="CloseActionCombo" Grid.Column="1" Width="190">
              <ComboBoxItem Content="{DynamicResource CloseAsk}" Tag="0"/>
              <ComboBoxItem Content="{DynamicResource CloseTray}" Tag="1"/>
              <ComboBoxItem Content="{DynamicResource CloseExit}" Tag="2"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource LoggingSection}" Classes="eyebrow"/>
          <CheckBox x:Name="FileLoggingToggle" Content="{DynamicResource LoggingToggle}"/>
          <TextBlock x:Name="FileLoggingHint"
                     TextWrapping="Wrap"
                     Classes="hint"/>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource CombatLogSection}" Classes="eyebrow"/>
          <CheckBox x:Name="AutoDpsOverlayToggle"
                    Content="{DynamicResource AutoDps}"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource SavedFights}" FontWeight="Medium" FontSize="14"/>
              <TextBlock Text="{DynamicResource SavedFightsHint}" Classes="hint"/>
            </StackPanel>
            <ComboBox x:Name="CombatLogLimitCombo" Grid.Column="1" Width="170">
              <ComboBoxItem Content="{DynamicResource Fights100}" Tag="100"/>
              <ComboBoxItem Content="{DynamicResource Fights500}" Tag="500"/>
              <ComboBoxItem Content="{DynamicResource Fights1000}" Tag="1000"/>
              <ComboBoxItem Content="{DynamicResource Unlimited}" Tag="0"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="NEXFORGE" Classes="eyebrow" HorizontalAlignment="Center"/>
          <TextBlock Text="Still under the forge." Classes="hint" FontStyle="Italic"/>
        </StackPanel>
      </Border>

      <Border x:Name="DeveloperSettingsPanel" Classes="panel" Padding="18">
        <StackPanel Spacing="8">
          <TextBlock Text="Developer tools" Classes="eyebrow"/>
          <TextBlock Text="A capture pipeline a Capture monitor lapon marad. Ez a felület nem cseréli le a packet parsert és a capture szolgáltatást."
                     Classes="body"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
