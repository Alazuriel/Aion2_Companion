<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AION_2_Companion.Views.Overlays.TimelineWindow"
        x:CompileBindings="False"
        Width="1020" Height="760"
        MinWidth="760" MinHeight="560"
        Title="AION 2 · Idővonal"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
        Foreground="#EAF7FF">
  <Window.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
  </Window.Styles>

  <Border BorderBrush="#45677F" BorderThickness="1" CornerRadius="16" Padding="18,14"
          BoxShadow="0 18 48 0 #85000000">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#F20A1422" Offset="0"/>
        <GradientStop Color="#E8142638" Offset="0.72"/>
        <GradientStop Color="#F2181118" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

      <!-- 0. Fejléc -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="HeaderDrag">
        <StackPanel Spacing="2">
          <TextBlock Text="COMBAT TIMELINE" Classes="kicker" FontSize="9"/>
          <TextBlock Name="TimelineTitle" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Name="TimelineSub" FontSize="11" Foreground="#71879B"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="ui quiet" Content="×" Padding="8,2" Click="CloseClick"/>
      </Grid>

      <!-- 1. Metrika váltó -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
        <Button Name="ModeDps" Tag="Dps" Classes="ui" Content="DPS" FontSize="12" Click="ModeClick"/>
        <Button Name="ModeDamage" Tag="Damage" Classes="ui" Content="Összes sebzés" FontSize="12" Click="ModeClick"/>
        <Button Name="ModeHps" Tag="Hps" Classes="ui" Content="HPS" FontSize="12" Click="ModeClick"/>
        <Button Name="ModeHeal" Tag="Heal" Classes="ui" Content="Összes gyógyítás" FontSize="12" Click="ModeClick"/>
      </StackPanel>

      <!-- 2. Játékos chipek a grafikonhoz -->
      <WrapPanel Grid.Row="2" Name="PlayerChips" Margin="0,8,0,0"/>

      <!-- 3. Grafikon -->
      <Border Grid.Row="3" Classes="inset" CornerRadius="12" Padding="14" Margin="0,10,0,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Name="ChartTitle" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" Name="ChartScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <Canvas Name="ChartCanvas" ClipToBounds="True"
                    Height="220" MinHeight="220"
                    HorizontalAlignment="Left"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- 4. Skill sávok a kiválasztott játékoshoz -->
      <Border Grid.Row="4" Classes="inset" CornerRadius="12" Padding="14" Margin="0,10,0,0"
              MaxHeight="250">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <TextBlock Name="LanesTitle" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" FontSize="10" Foreground="#60768A" HorizontalAlignment="Right"
                       Text="egy doboz 5 mp · sötétebb = több találat · zöld = gyógyítás"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Name="LaneLabels"/>
              <ScrollViewer Name="LaneScroll"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="LaneTicks"/>
              </ScrollViewer>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
      <!-- 5. Kiválasztott időpont részletei -->
      <Border Grid.Row="5" Name="EventDetailPanel" IsVisible="False"
              Classes="inset" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
        <StackPanel Spacing="4">
          <TextBlock Name="EventDetailTime" FontSize="12" FontWeight="SemiBold" Foreground="#45DFFF"/>
          <TextBlock Name="EventDetailList" FontSize="12" Foreground="#A8BAC8" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
