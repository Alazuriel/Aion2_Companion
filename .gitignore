# Nexforge data packs are ignored by default; only the encrypted runtime packs
# stored directly under Data are published.
*.nfg
*.nfg*.bak
!/Data/*.nfg
/Data/.nexforge/
/Private/

# Raw opcode research data stays private. The encrypted runtime catalog may be
# published with the other Data packs.
/Core/Wire/OpcodeRegistry.cs
/Data/*Opcode*.json
/Data/*Opcode*.csv

# Local research and data tools are private, including compiled executables.
/Tools/*
/scripts/build-release.ps1
/.github/workflows/release.yml
/scripts/get-release-notes.ps1
/Installer/NexforgeCompanion.iss

# Generated standalone installer payload (contains full application build).
Nexforge.Installer/Payload/Engine.exe
Nexforge.Installer/Payload/Engine.sha256
Nexforge.Installer/bin/
Nexforge.Installer/obj/
artifacts/inno-engine/
publish/installer/

