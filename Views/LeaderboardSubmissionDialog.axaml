<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AION_2_Companion.Views.LeaderboardSubmissionDialog"
        Width="760" Height="740" MinWidth="650" MinHeight="650"
        CanResize="True" ShowInTaskbar="False"
        Title="Nexforge · Submit boss result"
        Icon="/Assets/nexforge-companion.ico"
        Background="#07111D" Foreground="#ECEFF5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <!-- The fight's origin is read-only; player can only choose a participant from this log. -->
    <StackPanel Spacing="6" Margin="2,0,2,18">
      <TextBlock Text="NEXFORGE   /   COMMUNITY LEADERBOARD" Foreground="#43D9FD"
                 FontWeight="Bold" FontSize="11"/>
      <TextBlock Text="{DynamicResource UiSubmitReviewSubmission}" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource UiSubmitReviewCapturedEncounterBeforeSharingServerDecidesWheth}"
                 Foreground="#9BB2C6" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <!-- Fight identity -->
        <Border Background="#0C1C2E" BorderBrush="#245374" BorderThickness="1" CornerRadius="15" Padding="17">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource UiSubmitCapturedBossFight}" Classes="kicker"/>
                <TextBlock x:Name="BossText" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                <TextBlock x:Name="DateText" Foreground="#9EB4C5" FontSize="12"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#0F3345" BorderBrush="#226783" BorderThickness="1"
                      CornerRadius="20" Padding="12,7" VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource UiSubmitReadOnlyFightData}" Foreground="#4DE0FB" FontSize="10" FontWeight="Bold"/>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
              <Border Background="#091626" CornerRadius="10" BorderBrush="#243A51" BorderThickness="1" Padding="13,11">
                <StackPanel Spacing="5">
                  <TextBlock Text="{DynamicResource UiSubmitDuration}" Classes="kicker"/>
                  <TextBlock x:Name="DurationText" FontSize="19" FontWeight="SemiBold" Foreground="#EAF4FF"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#091626" CornerRadius="10" BorderBrush="#243A51" BorderThickness="1" Padding="13,11">
                <StackPanel Spacing="5">
                  <TextBlock Text="{DynamicResource UiSubmitDamage}" Classes="kicker"/>
                  <TextBlock x:Name="DamageText" FontSize="19" FontWeight="SemiBold" Foreground="#EAF4FF"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#091626" CornerRadius="10" BorderBrush="#243A51" BorderThickness="1" Padding="13,11">
                <StackPanel Spacing="5">
                  <TextBlock Text="{DynamicResource UiSubmitDps}" Classes="kicker"/>
                  <TextBlock x:Name="DpsText" FontSize="19" FontWeight="SemiBold" Foreground="#43D9FD"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Immutable character properties; player choice only comes from stored fight participants. -->
        <Border Background="#0A1727" BorderBrush="#263E54" BorderThickness="1" CornerRadius="14" Padding="17">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource UiSubmitCharacterIdentity}" Classes="kicker"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource UiSubmitFromEncounter}" Foreground="#7F9BAD" FontSize="10"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource UiSubmitSubmitAs}" Foreground="#9CB3C7" FontSize="12"/>
                <ComboBox x:Name="PlayerBox" MinHeight="38" SelectionChanged="PlayerChanged"/>
                <TextBlock Text="{DynamicResource UiSubmitOnlyPlayersRecordedThisFight}" Foreground="#7793A6" FontSize="10"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{DynamicResource UiSubmitClassCaptured}" Foreground="#9CB3C7" FontSize="12"/>
                <Border Background="#102238" BorderBrush="#2A4156" BorderThickness="1" CornerRadius="8" Padding="11,10">
                  <TextBlock x:Name="ClassText" Text="—" FontWeight="SemiBold" Foreground="#F1F7FC"/>
                </Border>
                <TextBlock Text="{DynamicResource UiSubmitCannotBeEdited}" Foreground="#7793A6" FontSize="10"/>
              </StackPanel>
            </Grid>
            <Border Background="#0C2533" BorderBrush="#256078" BorderThickness="1" CornerRadius="9" Padding="13,11">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource UiSubmitServerCaptureNfg}" Foreground="#55DFF6" FontWeight="Bold" FontSize="10"/>
                  <TextBlock x:Name="ServerText" Text="—" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ServerMetaText" Text="{DynamicResource UiSubmitServerIdNotAvailable}" Foreground="#9FB6C7" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{DynamicResource UiSubmitLocked}" Foreground="#68D6E9" FontWeight="Bold"
                           FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- What will actually be transmitted and what happens afterward. -->
        <Border Background="#0B1B2B" BorderBrush="#28445C" BorderThickness="1" CornerRadius="14" Padding="17">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource UiSubmitSubmissionCheck}" Classes="kicker"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource UiSubmitServerReview}" Foreground="#819EB1" FontSize="10"/>
                <TextBlock x:Name="ReviewText" Text="{DynamicResource UiSubmitPendingOrAutomaticReview}" Foreground="#F3BF6E"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{DynamicResource UiSubmitCombatEvidence}" Foreground="#819EB1" FontSize="10"/>
                <TextBlock x:Name="EvidenceText" Text="{DynamicResource UiSubmitCheckingSavedHits}" Foreground="#D9E7F1"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="EvidenceHintText" Text="{DynamicResource UiSubmitApprovalDeterminedServerAfterSubmission}"
                       Foreground="#88A6BB" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Background="#091523" BorderBrush="#293C54" BorderThickness="1" CornerRadius="12" Padding="14">
          <StackPanel Spacing="8">
            <CheckBox x:Name="ConsentBox" Content="{DynamicResource UiSubmitIAgreeSubmitThisResultNexforgeCommunityLeaderboard}"
                      IsCheckedChanged="ConsentChanged"/>
            <TextBlock Text="{DynamicResource UiSubmitOnlyEncounterSummaryIfAvailableCompactDamageHitEvidenc}"
                       Foreground="#8CA5BA" FontSize="11" TextWrapping="Wrap" Margin="4,0,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Foreground="#F4B66B" TextWrapping="Wrap" MinHeight="22"/>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0" ColumnSpacing="10">
      <StackPanel VerticalAlignment="Center" Spacing="3">
        <TextBlock Text="NEXFORGE   //   FAIR PLAY" Foreground="#43D9FD" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="{DynamicResource UiSubmitNoUploadUntilYouConfirm}" Foreground="#7794A9" FontSize="10"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="ui" Content="{DynamicResource Cancel}" Click="CloseClick" MinWidth="84"/>
      <Button Grid.Column="2" x:Name="SubmitButton" Classes="ui primary" Content="{DynamicResource UiSubmitSubmitResult}"
              Click="SubmitClick" MinWidth="140"/>
    </Grid>
  </Grid>
</Window>
