<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AION_2_Companion.Views.CharactersView"
             Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*" MinHeight="620" MaxWidth="980" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource CharactersKicker}" Classes="kicker"/>
        <TextBlock Text="{DynamicResource CharactersTitle}" Classes="h1" FontSize="29"/>
        <TextBlock Text="{DynamicResource CharactersSubtitle}" Classes="body"/>
      </StackPanel>

      <Border Grid.Row="1" Classes="hero" Width="660" MaxWidth="660" Padding="38"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
          <Border Width="76" Height="76" CornerRadius="22" Background="#A00A1422"
                  BorderBrush="#6545DFFF" BorderThickness="1" BoxShadow="0 0 30 0 #4845DFFF">
            <Image Source="/Assets/nexforge-logo.png" Margin="10" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
          </Border>
          <Border Classes="goldPill" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource StillUnderForge}" Classes="kicker" FontSize="9"/>
          </Border>
          <TextBlock Text="{DynamicResource CharactersProfileTitle}" Classes="h1" FontSize="25"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource CharactersProfileText}" Classes="body" FontSize="14"
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540"/>
          <Border Classes="rowline" Width="430" Margin="0,4"/>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Classes="pill" Margin="4"><TextBlock Text="{DynamicResource CharactersPublicDataTitle}" Classes="hint"/></Border>
            <Border Classes="pill" Margin="4"><TextBlock Text="{DynamicResource CharactersLinkTitle}" Classes="hint"/></Border>
            <Border Classes="pill" Margin="4"><TextBlock Text="{DynamicResource CharactersCombatTitle}" Classes="hint"/></Border>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
