<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AION_2_Companion.Views.Overlays.TimelineWindow"
        x:CompileBindings="False"
        Width="1140" Height="790" MinWidth="800" MinHeight="620"
        Title="Nexforge · Combat Timeline"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None" ShowInTaskbar="False" CanResize="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI" Foreground="#EAF7FF">
  <Window.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
    <Style Selector="Border.timelineCard">
      <Setter Property="Background" Value="#E00B1C2B"/>
      <Setter Property="BorderBrush" Value="#376E89"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.timelineKicker">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#64CDEB"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.tacticalTab">
      <Setter Property="Background" Value="#9B112333"/>
      <Setter Property="Foreground" Value="#D5E9F3"/>
      <Setter Property="BorderBrush" Value="#39546A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="Button.tacticalTab:pointerover">
      <Setter Property="Background" Value="#223D51"/>
      <Setter Property="BorderBrush" Value="#58B8D0"/>
    </Style>
    <Style Selector="Button.tacticalTab.primary">
      <Setter Property="Background" Value="#29D2F5"/>
      <Setter Property="Foreground" Value="#031520"/>
      <Setter Property="BorderBrush" Value="#73F1FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <Border BorderBrush="#2C7089" BorderThickness="1" CornerRadius="15"
          ClipToBounds="True" BoxShadow="0 16 45 0 #85000000">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#F4081724" Offset="0"/>
        <GradientStop Color="#F00B1B2A" Offset="0.63"/>
        <GradientStop Color="#EE08121E" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,15,18,17" RowDefinitions="Auto,Auto,Auto,292,270" RowSpacing="11">

          <!-- Window title + current player summary -->
          <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                Background="Transparent">
            <StackPanel Spacing="3" Grid.Row="0" Grid.Column="0" PointerPressed="HeaderDrag">
              <TextBlock Classes="timelineKicker" Text="NEXFORGE  //  COMBAT ANALYTICS"/>
              <TextBlock Text="Combat Timeline" FontSize="23" FontWeight="Bold"/>
            </StackPanel>
            <Button Grid.Row="0" Grid.Column="1" Classes="tacticalTab"
                    Padding="11,3" Content="✕" ToolTip.Tip="Close timeline" Click="CloseClick"
                    VerticalAlignment="Top"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="17">
              <TextBlock Name="TimelineTitle" FontSize="15" FontWeight="SemiBold" Foreground="#E7F9FF"/>
              <Border Grid.Column="1" Width="1" Background="#486A7F"/>
              <TextBlock Grid.Column="2" Name="TimelineSub" FontSize="11" Foreground="#9DC1D3" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Name="SelectedCountText" FontSize="11" Foreground="#64DCEB"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Grid>

          <!-- Metric selectors -->
          <Border Grid.Row="1" Classes="timelineCard" Padding="7,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Name="ModeDps" Tag="Dps" Classes="tacticalTab" Content="▥   DPS meter" Click="ModeClick"/>
              <Button Name="ModeDamage" Tag="Damage" Classes="tacticalTab" Content="✳   Total damage" Click="ModeClick"/>
              <Button Name="ModeHps" Tag="Hps" Classes="tacticalTab" Content="✚   HPS" Click="ModeClick"/>
              <Button Name="ModeHeal" Tag="Heal" Classes="tacticalTab" Content="♡   Total healing" Click="ModeClick"/>
            </StackPanel>
          </Border>

          <!-- Multi-select curve chips -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <WrapPanel Name="PlayerChips" VerticalAlignment="Center"/>
            <Button Name="SoloPlayerButton" Grid.Column="1" Classes="tacticalTab"
                    Content="Solo" ToolTip.Tip="Show only the player whose skills are open"
                    Click="SoloPlayerClick" VerticalAlignment="Center"/>
          </Grid>

          <!-- Overlaid multi-player chart -->
          <Border Grid.Row="3" Classes="timelineCard" Padding="14,11">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="▥" Foreground="#32DDF4" FontSize="19" FontWeight="Bold"/>
                  <StackPanel Spacing="1">
                    <TextBlock Name="ChartTitle" FontSize="15" FontWeight="SemiBold" Text="DPS Over Time"/>
                    <TextBlock Name="ChartMeta" FontSize="10" Foreground="#87A9BB"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                  <TextBlock Name="ZoomText" Text="Zoom ×1.0" FontSize="11" Foreground="#B1D3E3"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <Button Name="ZoomOutButton" Classes="tacticalTab" Content="−" Padding="11,4" Click="ZoomOutClick" ToolTip.Tip="Zoom out"/>
                  <Button Name="ZoomInButton" Classes="tacticalTab" Content="+" Padding="11,4" Click="ZoomInClick" ToolTip.Tip="Zoom in"/>
                  <Button Name="ZoomResetButton" Classes="tacticalTab" Content="⤢" Padding="11,4" Click="ZoomResetClick" ToolTip.Tip="Reset zoom"/>
                </StackPanel>
              </Grid>
              <ScrollViewer Grid.Row="1" Name="ChartScroll"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Canvas Name="ChartCanvas" Height="220" MinHeight="220" HorizontalAlignment="Left" ClipToBounds="True"/>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Skill lanes + event inspector -->
          <Grid Grid.Row="4" ColumnDefinitions="2.15*,1*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="timelineCard" Padding="12,10">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="5">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="▱" FontSize="17" Foreground="#37DAED"/>
                    <TextBlock Text="Skill Timeline" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Name="LanesTitle" FontSize="10" Foreground="#96B4C6"
                             VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid ColumnDefinitions="170,*">
                    <StackPanel Name="LaneLabels"/>
                    <ScrollViewer Grid.Column="1" Name="LaneScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <StackPanel Name="LaneTicks"/>
                    </ScrollViewer>
                  </Grid>
                </ScrollViewer>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,1,0,0">
                  <TextBlock Name="LaneCountLabel" Foreground="#7C9EB1" FontSize="10" VerticalAlignment="Center"/>
                  <Button Name="LoadMoreSkillsButton" Grid.Column="1" Classes="tacticalTab"
                          Padding="9,4" FontSize="10" Content="More skills" Click="LoadMoreSkillsClick"
                          IsVisible="False"/>
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="timelineCard" Padding="12,10" Name="EventDetailPanel">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="ⓘ" FontSize="17" Foreground="#81E9F8"/>
                  <TextBlock Text="Timeline Details" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="#24465E" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Choose a skill segment to see its events." Foreground="#8DAFC3" FontSize="11"/>
                    <TextBlock Text="Selected player's skill events appear below." Foreground="#8DAFC3" FontSize="10"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Name="EventDetailTime" Foreground="#4BE9F6" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                  <TextBlock Name="EventDetailList" FontSize="11" Foreground="#C1DAE8" TextWrapping="Wrap"/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </ScrollViewer>

      <!-- Real asynchronous calculation state, not just a frozen spinner -->
      <Border Name="LoadingOverlay" IsVisible="False" ZIndex="100" Background="#E8081422"
              IsHitTestVisible="False">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="320" CornerRadius="13" Background="#102B3D"
                BorderBrush="#39D2EF" BorderThickness="1" Padding="20,17">
          <StackPanel Spacing="12">
            <TextBlock Text="Preparing combat timeline" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#26DFF5"/>
            <TextBlock Name="LoadingText" Text="Reading fight events…" HorizontalAlignment="Center"
                       Foreground="#93BCD0" FontSize="11"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
