<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AION_2_Companion.Views.CombatLogWindow"
             x:CompileBindings="False"
             Background="Transparent" Foreground="#EAF7FF"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI">
  <UserControl.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#B00A1728"/>
      <Setter Property="Foreground" Value="#EAF7FF"/>
      <Setter Property="BorderBrush" Value="#2F5068"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style Selector="Button.logTab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#819CB2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="Button.logTab.selected">
      <Setter Property="Foreground" Value="#53DEFF"/>
      <Setter Property="BorderBrush" Value="#53DEFF"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,8,8">
    <!-- Page identity; the local storage path is deliberately visually secondary. -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Spacing="5">
        <TextBlock Text="NEXFORGE // COMBAT ARCHIVE" Classes="kicker"/>
        <TextBlock Text="{DynamicResource CombatLogTitle}" Classes="h1" FontSize="29"/>
        <TextBlock Text="{DynamicResource CombatLogSubtitle}" Classes="body"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Width="230" Spacing="5" VerticalAlignment="Bottom" Margin="14,0,0,0">
        <TextBlock Text="{DynamicResource UiCombatLogLocalStorage}" Classes="eyebrow" TextAlignment="Right"/>
        <TextBlock Name="StorageText" Classes="hint" TextAlignment="Right"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>

    <!-- Search & filters -->
    <Border Grid.Row="1" Classes="panel" Padding="12" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBox Name="SearchBox" Watermark="{DynamicResource CombatSearch}"
                 VerticalAlignment="Center" MinHeight="38" TextChanged="SearchTextChanged"/>
        <Border Grid.Column="1" Classes="inset" CornerRadius="10" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Button Name="AllEncountersButton" Classes="ui" Content="{DynamicResource EncounterModeAll}"
                    MinHeight="30" Padding="14,5" Click="EncounterModeClick" Tag="All"/>
            <Button Name="BossEncountersButton" Classes="ui" Content="{DynamicResource EncounterModeBosses}"
                    MinHeight="30" Padding="14,5" Click="EncounterModeClick" Tag="Bosses"/>
          </StackPanel>
        </Border>
        <CheckBox Grid.Column="2" Name="FavoritesOnlyToggle"
                  Content="{DynamicResource FavoritesOnly}" VerticalAlignment="Center"
                  IsCheckedChanged="FavoritesFilterChanged"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="266,14,*">
      <!-- Fight browser -->
      <Border Classes="panel" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="5" Margin="5,4,5,12">
            <TextBlock Text="{DynamicResource UiCombatLogFightLibrary}" Classes="kicker"/>
            <TextBlock Text="{DynamicResource SavedFights}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Name="FightCountText" Classes="hint" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="1" Background="#1A26394B" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="●" Foreground="#53DEFF" VerticalAlignment="Center" FontSize="10"/>
              <TextBlock Grid.Column="1" Name="SessionText" Classes="hint" TextWrapping="Wrap"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <ListBox Name="FightList" ItemsSource="{Binding Fights}"
                     SelectionChanged="FightSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="12" Background="#C9101E30" BorderBrush="#29475F"
                          BorderThickness="1" Padding="12,11">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                        <TextBlock Text="{Binding FavoriteText}" Foreground="#F5BA66" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="mono accent" FontSize="12"/>
                      </Grid>
                      <TextBlock Text="{Binding DateText}" Classes="hint" FontSize="11"/>
                      <Border Background="#162C4155" CornerRadius="6" Padding="7,5">
                        <TextBlock Text="{Binding TotalsText}" Classes="mono" Foreground="#BDD5E3" FontSize="11"
                                   TextWrapping="Wrap"/>
                      </Border>
                      <TextBlock Text="{Binding StateText}" Classes="warn" FontSize="11"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Name="EmptyLogText" Text="{DynamicResource NoMatchingFight}"
                       Classes="body" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"/>
          </Grid>
          <Button Grid.Row="3" Name="LoadOlderFightsButton" Classes="ui"
                  Content="{DynamicResource LoadOlderFights}" Margin="0,12,0,0"
                  HorizontalAlignment="Stretch" Click="LoadOlderFightsClick" IsVisible="False"/>
        </Grid>
      </Border>

      <!-- Selected encounter: top-level actions and metrics stay in sight while tabs separate deep detail. -->
      <Border Grid.Column="2" Classes="panel" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource UiCombatLogSelectedEncounter}" Classes="kicker"/>
              <TextBlock Name="EncounterName" Text="{DynamicResource NoSelectedFight}"
                         FontSize="25" FontWeight="Bold"/>
              <TextBlock Name="EncounterMeta" Text="—" Classes="body" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Name="OpenDpsButton" Classes="ui primary"
                    Content="{DynamicResource DpsView}" MinWidth="104" VerticalAlignment="Top"
                    Click="OpenDpsClick"/>
          </Grid>

          <WrapPanel Grid.Row="1" Margin="0,16,0,4" Orientation="Horizontal">
            <Button Name="FavoriteButton" Classes="ui" Content="{DynamicResource Favorite}"
                    Margin="0,0,8,7" Click="ToggleFavoriteClick"/>
            <Button Name="CompareButton" Classes="ui" Content="{DynamicResource Compare}"
                    Margin="0,0,8,7" Click="CompareClick"/>
            <Button Name="CopyButton" Classes="ui" Content="{DynamicResource CopyDiscord}"
                    Margin="0,0,8,7" Click="CopyDiscordClick"/>
            <Button Name="ShareButton" Classes="ui primary" Content="{DynamicResource LeaderboardShare}"
                    Margin="0,0,8,7" Click="ShareResultClick"/>
            <Button Name="DeleteButton" Classes="ui" Content="{DynamicResource Delete}"
                    Foreground="#F58C86" Margin="0,0,0,7" Click="DeleteClick"/>
          </WrapPanel>

          <!-- Four fixed metrics -->
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Margin="0,13,0,15">
            <Border Background="#13283B" BorderBrush="#335C73" BorderThickness="1" CornerRadius="12" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource TotalDamage}" Classes="eyebrow"/>
                <TextBlock Name="TotalDamageText" Classes="metric" FontSize="21"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#142E42" BorderBrush="#35677E" BorderThickness="1" CornerRadius="12" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource GroupDps}" Classes="eyebrow"/>
                <TextBlock Name="TotalDpsText" Classes="metric accent" FontSize="21"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#13283B" BorderBrush="#335C73" BorderThickness="1" CornerRadius="12" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource TotalHealing}" Classes="eyebrow"/>
                <TextBlock Name="TotalHealingText" Classes="metric" FontSize="21"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#13283B" BorderBrush="#335C73" BorderThickness="1" CornerRadius="12" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource GroupHps}" Classes="eyebrow"/>
                <TextBlock Name="TotalHpsText" Classes="metric" FontSize="21"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Use regular child Grids rather than lazy TabControl Content templates so FindControl works. -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <Button Name="BreakdownTabButton" Classes="logTab selected" Content="{DynamicResource UiCombatLogPerformance}"
                    Tag="Breakdown" Click="DetailsTabClick"/>
            <Button Name="NotesTabButton" Classes="logTab" Content="{DynamicResource UiCombatLogNotes}"
                    Tag="Notes" Click="DetailsTabClick"/>
            <Button Name="EnemiesTabButton" Classes="logTab" Content="{DynamicResource UiCombatLogEncounterInfo}"
                    Tag="Enemies" Click="DetailsTabClick"/>
          </StackPanel>

          <Grid Grid.Row="4">
            <Grid Name="DetailsBreakdownPanel" ColumnDefinitions="226,12,*">
              <Border Classes="inset" Padding="12">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Margin="4,0,4,12" Spacing="4">
                    <TextBlock Text="{DynamicResource Players}" Classes="section"/>
                    <TextBlock Text="{DynamicResource UiCombatLogSelectPlayerInspectDamageHealing}" Classes="hint" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ListBox Grid.Row="1" Name="PlayerList" ItemsSource="{Binding Players}"
                           SelectionChanged="PlayerSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#142638" BorderBrush="#34556D" BorderThickness="1"
                                CornerRadius="10" Padding="10">
                          <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ClassName}" Classes="hint"/>
                            <TextBlock Text="{Binding DamageText}" Classes="mono accent" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HealingText}" Classes="mono" Foreground="#8DD9B5"
                                       FontSize="11" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="inset" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Spacing="5">
                      <TextBlock Name="SelectedPlayerName" Text="{DynamicResource PlayerDetails}"
                                 Classes="section"/>
                      <TextBlock Name="SelectedPlayerMeta" Text="—" Classes="hint" TextWrapping="Wrap"/>
                      <TextBlock Name="RecordText" Classes="warn" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                      <Button Name="PlayerDetailsButton" Classes="ui" Content="{DynamicResource Details}"
                              Margin="0,0,7,7" Click="OpenPlayerDetailsClick"/>
                      <Button Name="TimelineButton" Classes="ui" Content="{DynamicResource Timeline}"
                              Click="OpenTimelineClick"/>
                    </WrapPanel>
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="*,80,48,50" Margin="4,18,4,9">
                    <TextBlock Text="{DynamicResource UiCombatLogSkill}" Classes="eyebrow"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Total}" Classes="eyebrow" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Hit}" Classes="eyebrow" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource Crit}" Classes="eyebrow" TextAlignment="Right"/>
                  </Grid>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Skills}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#243F55" BorderThickness="0,1,0,0" Padding="5,10">
                            <Grid ColumnDefinitions="*,80,48,50">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding TypeText}" FontSize="10"
                                           Foreground="{Binding TypeColor}" Width="36" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding TotalText}" Classes="mono" TextAlignment="Right"/>
                              <TextBlock Grid.Column="2" Text="{Binding HitsText}" Classes="mono" TextAlignment="Right"/>
                              <TextBlock Grid.Column="3" Text="{Binding CritText}" Classes="mono" TextAlignment="Right"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

            <Border Name="NotesContentPanel" Classes="inset" Padding="18" IsVisible="False">
              <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="5" Margin="0,0,0,14">
                  <TextBlock Text="{DynamicResource UiCombatLogFightNotes}" Classes="section"/>
                  <TextBlock Text="{DynamicResource UiCombatLogPersonalNotesStayLocalEncounterArchive}" Classes="hint"/>
                </StackPanel>
                <TextBox Grid.Row="1" Name="NotesBox" Watermark="{DynamicResource FightNotesWatermark}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                         VerticalAlignment="Stretch"/>
                <Button Grid.Row="2" Name="SaveNotesButton" Classes="ui primary"
                        Content="{DynamicResource SaveNotes}" HorizontalAlignment="Right"
                        Margin="0,12,0,0" Click="SaveNotesClick"/>
              </Grid>
            </Border>

            <Border Name="EncounterEnemiesPanel" Classes="inset" Padding="18" IsVisible="False">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource UiCombatLogEncounterDetails}" Classes="section"/>
                <TextBlock Text="{DynamicResource UiCombatLogEnemiesPullsRecordedDuringThisFight}" Classes="hint"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                  <TextBlock Name="EncounterMobsText" Text="—" TextWrapping="Wrap" Foreground="#CBDEEC"/>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="2,13,2,0">
            <StackPanel Spacing="4">
              <TextBlock Name="ComparisonHint" Classes="hint" TextWrapping="Wrap"/>
              <TextBlock Text="{DynamicResource HealingAccuracyHint}" Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Name="ActionStatusText" Classes="ok"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="230"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
