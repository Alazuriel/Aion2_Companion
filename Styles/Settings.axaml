<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="#C20B1523"/>
    <Setter Property="BorderBrush" Value="#314B63"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="BoxShadow" Value="0 12 30 0 #48000000"/>
  </Style>

  <Style Selector="Border.settings-card:pointerover">
    <Setter Property="BorderBrush" Value="#456783"/>
  </Style>

  <Style Selector="Border.settings-row">
    <Setter Property="Background" Value="#76101C2B"/>
    <Setter Property="BorderBrush" Value="#293F54"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="13,11"/>
  </Style>

  <Style Selector="Border.settings-icon">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="#281FC7E8"/>
    <Setter Property="BorderBrush" Value="#6045DFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="TextBlock.settings-category">
    <Setter Property="Foreground" Value="#F2F8FC"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="TextBlock.settings-label">
    <Setter Property="Foreground" Value="#E7F2F9"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>

  <Style Selector="TextBlock.settings-index">
    <Setter Property="Foreground" Value="#45DFFF"/>
    <Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="1.4"/>
  </Style>

  <Style Selector="Border.settings-status">
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Background" Value="#201FC7E8"/>
    <Setter Property="BorderBrush" Value="#5545DFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Border.settings-status.gold">
    <Setter Property="Background" Value="#24C9A85C"/>
    <Setter Property="BorderBrush" Value="#66D8B96A"/>
  </Style>

  <Style Selector="ComboBox.settings-select">
    <Setter Property="MinWidth" Value="190"/>
    <Setter Property="MaxWidth" Value="240"/>
  </Style>
</Styles>
