<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AION_2_Companion.Views.CombatComparisonWindow"
        x:CompileBindings="False"
        Width="1040" Height="700" MinWidth="820" MinHeight="560"
        Title="AION 2 Companion · Fight összehasonlítás"
        Icon="/Assets/nexforge-companion.ico"
        Background="#090B0F" Foreground="#ECEAE6"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="22">
    <StackPanel Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Fight összehasonlítás" Classes="h1"/>
      <TextBlock Text="A változás mindig a B fight eredménye mínusz az A fight eredménye." Classes="body"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,14,*" Margin="0,0,0,14">
      <Border Classes="panel" Padding="14">
        <StackPanel Spacing="5">
          <TextBlock Text="A · ALAP" Classes="eyebrow"/>
          <TextBlock Text="{Binding FightAName}" Classes="section" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding FightAMeta}" Classes="hint"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="panel" Padding="14">
        <StackPanel Spacing="5">
          <TextBlock Text="B · ÖSSZEHASONLÍTOTT" Classes="eyebrow"/>
          <TextBlock Text="{Binding FightBName}" Classes="section" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding FightBMeta}" Classes="hint"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,10,*,10,*" Margin="0,0,0,14">
      <Border Classes="inset" Padding="13">
        <StackPanel Spacing="4">
          <TextBlock Text="GROUP DPS" Classes="eyebrow"/>
          <TextBlock Text="{Binding GroupDpsText}" Classes="mono accent" FontSize="17"/>
          <TextBlock Text="{Binding GroupDpsDelta}" Foreground="{Binding GroupDpsDeltaBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="inset" Padding="13">
        <StackPanel Spacing="4">
          <TextBlock Text="TOTAL DAMAGE" Classes="eyebrow"/>
          <TextBlock Text="{Binding DamageText}" Classes="mono accent" FontSize="17"/>
          <TextBlock Text="{Binding DamageDelta}" Foreground="{Binding DamageDeltaBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Classes="inset" Padding="13">
        <StackPanel Spacing="4">
          <TextBlock Text="TOTAL HEAL" Classes="eyebrow"/>
          <TextBlock Text="{Binding HealingText}" Classes="mono accent" FontSize="17"/>
          <TextBlock Text="{Binding HealingDelta}" Foreground="{Binding HealingDeltaBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Classes="panel" Padding="14">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="Játékosonként" Classes="section" Margin="2,0,0,10"/>
        <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,*,*,*" Margin="10,0,10,7">
          <TextBlock Text="JÁTÉKOS" Classes="eyebrow"/>
          <TextBlock Grid.Column="1" Text="A DPS" Classes="eyebrow" TextAlignment="Right"/>
          <TextBlock Grid.Column="2" Text="B DPS" Classes="eyebrow" TextAlignment="Right"/>
          <TextBlock Grid.Column="3" Text="DPS Δ" Classes="eyebrow" TextAlignment="Right"/>
          <TextBlock Grid.Column="4" Text="DMG Δ" Classes="eyebrow" TextAlignment="Right"/>
          <TextBlock Grid.Column="5" Text="HPS Δ" Classes="eyebrow" TextAlignment="Right"/>
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Players}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="inset" Padding="10,9">
                <Grid ColumnDefinitions="2*,*,*,*,*,*">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ClassName}" Classes="hint" FontSize="11"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding DpsA}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding DpsB}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding DpsDelta}" Foreground="{Binding DpsDeltaBrush}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding DamageDelta}" Foreground="{Binding DamageDeltaBrush}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding HpsDelta}" Foreground="{Binding HpsDeltaBrush}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
