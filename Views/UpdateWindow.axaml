<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AION_2_Companion.Views.UpdateWindow"
        Width="720" Height="635" MinWidth="610" MinHeight="535"
        CanResize="True" ShowInTaskbar="False"
        Title="Nexforge Update Center"
        Icon="/Assets/nexforge-companion.ico"
        Background="#080E19" Foreground="#EAF7FF"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26" RowSpacing="17">
    <!-- Compact brand bar: the release title has its own hierarchy below. -->
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <Border Width="5" Height="15" CornerRadius="2" Background="#45DFFF"/>
        <TextBlock Text="NEXFORGE  //  UPDATE CENTER" Classes="kicker"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Column="1" CornerRadius="999" BorderThickness="1"
              BorderBrush="#2F6A72" Background="#153E3C" Padding="11,5">
        <TextBlock Text="NEW RELEASE" FontSize="10" FontWeight="SemiBold"
                   Foreground="#7AEBD5" LetterSpacing="1.2"/>
      </Border>
    </Grid>

    <!-- Hero: clear release identity and version, no giant empty card. -->
    <Border Grid.Row="1" CornerRadius="17" Background="#101F30"
            BorderBrush="#446A83" BorderThickness="1" Padding="19">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Width="62" Height="62" CornerRadius="15" Background="#112B40"
                BorderBrush="#45DFFF" BorderThickness="1">
          <Image Source="/Assets/nexforge-companion-icon.png" Margin="6"
                 RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="AION 2 COMPANION" Classes="kicker"/>
          <TextBlock x:Name="ReleaseNameText" FontSize="22" FontWeight="SemiBold"
                     TextWrapping="Wrap" MaxLines="2"/>
          <TextBlock x:Name="ReleaseMetaText" Foreground="#8EAAC0" FontSize="12"/>
        </StackPanel>
        <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="10"
                Background="#193C4F" BorderBrush="#39728D" BorderThickness="1"
                Padding="11,8">
          <TextBlock x:Name="VersionBadgeText" Foreground="#5BDEFF"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13"
                     FontWeight="SemiBold"/>
        </Border>
      </Grid>
    </Border>

    <!-- Release notes are actual styled sections rather than visible Markdown syntax. -->
    <Border Grid.Row="2" Classes="panel" CornerRadius="16" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="18,15" BorderBrush="#263F54" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource UpdateChanges}" Classes="section"/>
            <TextBlock Grid.Column="1" Text="GITHUB RELEASE NOTES" Classes="kicker"
                       FontSize="10" Opacity="0.75"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="3" Padding="17,12,14,18"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ReleaseNotesPanel" Spacing="8"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Installation controls remain untouched in behavior. -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel VerticalAlignment="Center" Spacing="8" MinWidth="210">
          <TextBlock x:Name="UpdateStatusText" Classes="hint" TextWrapping="Wrap"/>
          <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0"
                       Maximum="100" IsVisible="False"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button x:Name="LaterButton" Classes="ui" MinWidth="93"
                  Content="{DynamicResource UpdateLater}" Click="LaterClick"/>
          <Button x:Name="InstallButton" Classes="ui primary" MinWidth="151"
                  Content="{DynamicResource UpdateInstall}" Click="InstallClick"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#122032" CornerRadius="9" Padding="12,9">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <TextBlock Text="✓" Foreground="#58E0B2" FontWeight="Bold" FontSize="14"/>
          <TextBlock Text="{DynamicResource UpdateVerifiedHint}" Classes="hint"
                     Foreground="#99B2C4" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
