<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AION_2_Companion.Views.LeaderboardSubmissionDialog"
        x:CompileBindings="False"
        Width="900" Height="790" MinWidth="710" MinHeight="620"
        CanResize="True" ShowInTaskbar="False"
        Title="Nexforge · Submission Center"
        Icon="/Assets/nexforge-companion.ico"
        Background="#07111D" Foreground="#ECEFF5"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Theme.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22" RowSpacing="13">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="5">
        <TextBlock Text="NEXFORGE  /  COMBAT HISTORY" Foreground="#42D9FF" FontWeight="Bold" FontSize="10"/>
        <TextBlock Text="{DynamicResource UiSubmissionCenterTitle}" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource UiSubmissionCenterSubtitle}" Foreground="#94ADBE" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#103247" CornerRadius="12" Padding="11,6" VerticalAlignment="Top">
        <TextBlock Text="{DynamicResource UiSubmissionReadOnly}" Foreground="#4BDDFB" FontSize="10" FontWeight="Bold"/>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="9">
      <Button x:Name="IndividualModeButton" Grid.Column="0" Classes="ui primary"
              MinHeight="37" Click="ModeClick" Tag="individual"
              Content="{DynamicResource UiSubmissionIndividual}"/>
      <Button x:Name="GroupModeButton" Grid.Column="1" Classes="ui"
              MinHeight="37" Click="ModeClick" Tag="group"
              Content="{DynamicResource UiSubmissionGroup}"/>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,3,0">
        <Border Background="#0D1D30" BorderBrush="#25516B" BorderThickness="1" CornerRadius="12" Padding="15">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource UiSubmissionEncounter}" FontSize="9" Foreground="#46D8FF" FontWeight="Bold"/>
                <TextBlock x:Name="BossText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DateText" FontSize="11" Foreground="#9AB2C7"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{DynamicResource UiSubmissionSavedFight}" Foreground="#8ABDD4" FontSize="10"/>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <Border Background="#0A1625" CornerRadius="8" Padding="11,9">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource UiSubmitDuration}" Classes="kicker"/>
                  <TextBlock x:Name="DurationText" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#0A1625" CornerRadius="8" Padding="11,9">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource UiSubmissionParticipants}" Classes="kicker"/>
                  <TextBlock x:Name="ParticipantCountText" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#0A1625" CornerRadius="8" Padding="11,9">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource UiSubmitServerCaptureNfg}" Classes="kicker"/>
                  <TextBlock x:Name="ServerText" FontSize="15" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="ServerMetaText" FontSize="10" Foreground="#8BA5B8"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Personal result can NEVER be selected from an arbitrary fight row. -->
        <StackPanel x:Name="IndividualPanel" Spacing="12">
          <Border Background="#0A1929" BorderBrush="#26435D" BorderThickness="1" CornerRadius="12" Padding="15">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource UiSubmissionVerifiedOwner}" Foreground="#DCECF8" FontWeight="SemiBold" FontSize="14"/>
                <Button x:Name="RefreshVerifiedButton" Grid.Column="1" Classes="ui quiet" MinHeight="24"
                        Content="{DynamicResource UiSubmissionRefreshVerification}" Click="RefreshVerifiedClick"/>
              </Grid>
              <TextBlock x:Name="VerifiedCharacterText" FontSize="17" FontWeight="SemiBold" Foreground="#44DCE9" Text="—"/>
              <TextBlock x:Name="VerificationStatusText" Foreground="#96AEBF" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{DynamicResource UiSubmissionCannotSwitchParticipant}" FontSize="10" Foreground="#7199AD" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Text="{DynamicResource UiSubmitClassCaptured}" Classes="kicker"/>
                  <TextBlock x:Name="ClassText" Text="—" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{DynamicResource UiSubmissionVerifiedLocation}" Classes="kicker"/>
                  <TextBlock x:Name="MatchedLocationText" Text="—" FontSize="12"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Background="#0D2332" CornerRadius="9" Padding="10">
              <StackPanel Spacing="5"><TextBlock Text="{DynamicResource UiSubmitDamage}" Classes="kicker"/><TextBlock x:Name="DamageText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#0D2332" CornerRadius="9" Padding="10">
              <StackPanel Spacing="5"><TextBlock Text="DPS" Classes="kicker"/><TextBlock x:Name="DpsText" Text="—" FontSize="16" Foreground="#45DFFF" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#0D2332" CornerRadius="9" Padding="10">
              <StackPanel Spacing="5"><TextBlock Text="{DynamicResource UiSubmissionHealing}" Classes="kicker"/><TextBlock x:Name="HealingText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#0D2332" CornerRadius="9" Padding="10">
              <StackPanel Spacing="5"><TextBlock Text="HPS" Classes="kicker"/><TextBlock x:Name="HpsText" Text="—" FontSize="16" Foreground="#5EE2A5" FontWeight="SemiBold"/></StackPanel>
            </Border>
          </Grid>
          <Border Background="#0B1B2C" BorderBrush="#293D53" BorderThickness="1" CornerRadius="9" Padding="13">
            <StackPanel Spacing="5">
              <TextBlock Text="{DynamicResource UiSubmitCombatEvidence}" Foreground="#90AABF" FontSize="10"/>
              <TextBlock x:Name="EvidenceText" Foreground="#E2EDF7" FontSize="12"/>
              <TextBlock Text="{DynamicResource UiSubmissionServerVerifiesOwnership}" Foreground="#82A1B5" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Full fight preview uses recorded participants and has NO editable ownership selectors. -->
        <StackPanel x:Name="GroupPanel" IsVisible="False" Spacing="12">
          <Border Background="#0A1929" BorderBrush="#25516B" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource UiSubmissionGroupSummary}" FontSize="14" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="7">
                <StackPanel Spacing="4"><TextBlock Text="{DynamicResource UiSubmissionTeamDamage}" Classes="kicker"/><TextBlock x:Name="TeamDamageText" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource UiSubmissionTeamDps}" Classes="kicker"/><TextBlock x:Name="TeamDpsText" FontSize="16" Foreground="#45DFFF" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{DynamicResource UiSubmissionTeamHealing}" Classes="kicker"/><TextBlock x:Name="TeamHealingText" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="{DynamicResource UiSubmissionTeamHps}" Classes="kicker"/><TextBlock x:Name="TeamHpsText" FontSize="16" Foreground="#5EE2A5" FontWeight="SemiBold"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="#0B1929" BorderBrush="#29455B" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel Spacing="9">
              <TextBlock Text="{DynamicResource UiSubmissionObservedPlayers}" FontWeight="SemiBold" FontSize="13"/>
              <ScrollViewer MaxHeight="275" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="635" Spacing="6">
                  <Grid ColumnDefinitions="155,125,95,125,95" ColumnSpacing="8" Margin="5,1,5,7">
                    <TextBlock Text="{DynamicResource UiSubmissionCharacter}" Classes="kicker"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource UiSubmitDamage}" Classes="kicker"/>
                    <TextBlock Grid.Column="2" Text="DPS" Classes="kicker"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource UiSubmissionHealing}" Classes="kicker"/>
                    <TextBlock Grid.Column="4" Text="HPS" Classes="kicker"/>
                  </Grid>
                  <ItemsControl x:Name="ParticipantList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#102338" CornerRadius="6" Padding="7,7" Margin="0,0,0,5">
                          <Grid ColumnDefinitions="155,125,95,125,95" ColumnSpacing="8">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding ClassName}" Foreground="#7998AE" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Damage}" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="{Binding Dps}" Foreground="#45DFFF" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="{Binding Healing}" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="{Binding Hps}" Foreground="#5EE2A5" VerticalAlignment="Center" FontSize="11"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border Background="#241F1D" BorderBrush="#624934" BorderThickness="1" CornerRadius="9" Padding="13">
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource UiSubmissionGroupReviewHeading}" Foreground="#FFC078" FontWeight="SemiBold" FontSize="11"/>
              <TextBlock Text="{DynamicResource UiSubmissionGroupPrivacyNoticeV2}" Foreground="#C8B7A5" TextWrapping="Wrap" FontSize="11"/>
              <CheckBox x:Name="GroupPrivateNamesBox" Content="{DynamicResource UiSubmissionPrivateNamesAcknowledgement}" IsCheckedChanged="ConsentChanged"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Background="#0A1624" BorderBrush="#2A3B4E" BorderThickness="1" CornerRadius="10" Padding="13">
          <StackPanel Spacing="6">
            <CheckBox x:Name="ConsentBox" Content="{DynamicResource UiSubmissionConsent}" IsCheckedChanged="ConsentChanged"/>
            <TextBlock Text="{DynamicResource UiSubmissionNoPackets}" Foreground="#92ABBC" TextWrapping="Wrap" FontSize="10"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Foreground="#FFBE78" TextWrapping="Wrap" FontSize="11" MinHeight="25"/>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock Text="{DynamicResource UiSubmissionModerated}" Foreground="#819CB1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
      <Button Grid.Column="1" Classes="ui" Content="{DynamicResource Cancel}" Click="CloseClick" MinWidth="90"/>
      <Button Grid.Column="2" x:Name="SubmitButton" Classes="ui primary" MinWidth="170"
              Content="{DynamicResource UiSubmissionSendIndividual}" Click="SubmitClick"/>
    </Grid>
  </Grid>
</Window>
