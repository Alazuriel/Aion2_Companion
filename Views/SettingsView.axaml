<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AION_2_Companion.Views.SettingsView"
             Background="Transparent"
             Foreground="#EAF7FF">
  <UserControl.Styles>
    <StyleInclude Source="avares://AION 2 Companion/Styles/Settings.axaml"/>
    <Style Selector="CheckBox.phaseward-choice">
      <Setter Property="Foreground" Value="#E4F1FA"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch" Margin="0,0,8,28">
      <!-- LEGACY #21 · native Nexforge styling; no automated submission -->
      <Border CornerRadius="20" BorderBrush="#3F617E" BorderThickness="1" Padding="20">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#EA0B1827" Offset="0"/>
            <GradientStop Color="#DF131E33" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel Spacing="10">
          <TextBlock Text="NEXFORGE / DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="#58D9F4"/>
          <TextBlock x:Name="DiagnosticsHeadingText" FontSize="20" FontWeight="SemiBold" Foreground="#F2F7FF"/>
          <TextBlock x:Name="DiagnosticsSubtitleText" FontSize="12" TextWrapping="Wrap" Foreground="#9BB0C5"/>
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="DiagnosticsManualButton" Classes="ui" Margin="0,3,9,3" Click="DiagnosticManualClick"/>
            <Button x:Name="DiagnosticsReviewButton" Classes="ui" Margin="0,3,9,3" Click="DiagnosticReviewClick"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border CornerRadius="20" BorderBrush="#466782" BorderThickness="1" Padding="22"
              BoxShadow="0 18 44 0 #60000000">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E90A1726" Offset="0"/>
            <GradientStop Color="#D8102132" Offset="0.64"/>
            <GradientStop Color="#DD211C1C" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <Border Width="54" Height="54" CornerRadius="15" Background="#A30A1422"
                  BorderBrush="#657D91" BorderThickness="1" BoxShadow="0 0 25 0 #4845DFFF">
            <Image Source="/Assets/nexforge-companion-icon.png" Margin="2" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource SettingsKicker}" Classes="kicker"/>
            <TextBlock Text="{DynamicResource SettingsHeroTitle}" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource SettingsHeroSubtitle}" Classes="body" MaxWidth="650"/>
          </StackPanel>
          <Border Grid.Column="2" Classes="settings-status gold" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="7" Height="7" Fill="#D8B96A" VerticalAlignment="Center"/>
              <TextBlock x:Name="VersionText" Classes="mono" FontSize="11" Foreground="#F0D99F"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource UiSettings01General}" Classes="settings-index"/>
            <TextBlock Text="{DynamicResource GeneralCategory}" Classes="settings-category"/>
            <TextBlock Text="{DynamicResource GeneralCategoryHint}" Classes="hint"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource LanguageLabel}" Classes="settings-label"/><TextBlock Text="{DynamicResource LanguageHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Classes="settings-select"/>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="7">
                <StackPanel Spacing="3">
                  <TextBlock Text="{DynamicResource CommunityLanguageTitle}" Classes="settings-label"/>
                  <TextBlock Text="{DynamicResource CommunityLanguageHint}" Classes="hint"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="ui" Content="{DynamicResource ImportLanguage}" Click="ImportLanguageClick"/>
                  <Button Classes="ui quiet" Content="{DynamicResource OpenLanguageFolder}" Click="OpenLanguageFolderClick"/>
                </StackPanel>
                <TextBlock x:Name="LanguageImportStatus" Grid.Row="1" Grid.ColumnSpan="2" Classes="hint"
                           Foreground="#74D9F5" IsVisible="False" TextWrapping="Wrap"/>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource CloseBehavior}" Classes="settings-label"/><TextBlock Text="{DynamicResource CloseBehaviorHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="CloseActionCombo" Grid.Column="1" Classes="settings-select">
                  <ComboBoxItem Content="{DynamicResource CloseAsk}" Tag="0"/><ComboBoxItem Content="{DynamicResource CloseTray}" Tag="1"/><ComboBoxItem Content="{DynamicResource CloseExit}" Tag="2"/>
                </ComboBox>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource TutorialSettingTitle}" Classes="settings-label"/><TextBlock Text="{DynamicResource TutorialSettingHint}" Classes="hint"/></StackPanel>
                <Button Grid.Column="1" Classes="ui" Content="{DynamicResource RestartTutorial}" Click="RestartTutorialClick" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource NexforgeLinkTitle}" Classes="settings-label"/><TextBlock Text="{DynamicResource NexforgeLinkHint}" Classes="hint"/></StackPanel>
                <Button Grid.Column="1" Classes="ui" Content="{DynamicResource OpenNexforge}" Click="OpenNexforgeClick" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource UiSettings02Monitoring}" Classes="settings-index"/>
            <TextBlock Text="{DynamicResource CaptureCategory}" Classes="settings-category"/>
            <TextBlock Text="{DynamicResource CaptureCategoryHint}" Classes="hint"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row">
              <StackPanel Spacing="4"><CheckBox x:Name="AutoCaptureToggle" Content="{DynamicResource AutoCapture}"/><TextBlock Text="{DynamicResource AutoCaptureHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource MapHelper}" Classes="settings-label"/><TextBlock Text="{DynamicResource MapHelperHint}" Classes="hint"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="ui quiet" Content="i" Width="30" Height="30" FontSize="13" ToolTip.Tip="{DynamicResource MapHelperTooltip}"/>
                  <CheckBox x:Name="MapHelperToggle" Content="{DynamicResource Enabled}"/>
                </StackPanel>
                <Border x:Name="MapAdminWarning" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" Margin="0,11,0,0" Padding="11,9" CornerRadius="9" Background="#24F59E0B" BorderBrush="#88F59E0B" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="9"><Border Width="20" Height="20" CornerRadius="10" Background="#F59E0B"><TextBlock Text="!" Foreground="#17120A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{DynamicResource MapAdminWarning}" Foreground="#FBBF24" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings03Combat}" Classes="settings-index"/><TextBlock Text="{DynamicResource CombatCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource CombatCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><StackPanel Spacing="4"><CheckBox x:Name="AutoDpsOverlayToggle" Content="{DynamicResource AutoDps}"/><TextBlock Text="{DynamicResource AutoDpsHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel></Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource DpsEncounterScope}" Classes="settings-label"/><TextBlock Text="{DynamicResource DpsEncounterScopeHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="DpsEncounterModeCombo" Grid.Column="1" Classes="settings-select"><ComboBoxItem Content="{DynamicResource EncounterModeAll}" Tag="0"/><ComboBoxItem Content="{DynamicResource EncounterModeBosses}" Tag="1"/></ComboBox>
              </Grid>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="{DynamicResource SavedFights}" Classes="settings-label"/><TextBlock Text="{DynamicResource SavedFightsHint}" Classes="hint"/></StackPanel>
                <ComboBox x:Name="CombatLogLimitCombo" Grid.Column="1" Classes="settings-select"><ComboBoxItem Content="{DynamicResource Fights100}" Tag="100"/><ComboBoxItem Content="{DynamicResource Fights500}" Tag="500"/><ComboBoxItem Content="{DynamicResource Fights1000}" Tag="1000"/><ComboBoxItem Content="{DynamicResource Unlimited}" Tag="0"/></ComboBox>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings04Overlay}" Classes="settings-index"/><TextBlock Text="{DynamicResource OverlayCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource OverlayCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource DpsMeter}" Classes="settings-label"/><TextBlock Text="{DynamicResource DpsOverlayHint}" Classes="hint"/></StackPanel><Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenDpsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <CheckBox x:Name="AutoPhasewardToggle" Content="{DynamicResource PwAutoHud}"/>
                  <TextBlock Text="{DynamicResource PwReadyHint}" Classes="hint" Margin="25,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenPhasewardOverlayClick" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Classes="settings-row" BorderBrush="#335875" BorderThickness="1" CornerRadius="14" Padding="13">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="PhasewardSettingsHeading" Text="PHASEWARD // COMMUNITY" FontWeight="Bold" Foreground="#55DBF4" FontSize="11"/>
                  <TextBlock x:Name="PhasewardSettingsSubheading" Text="Boss observations can be sent to Nexforge for server-side research." FontSize="12" Foreground="#9DBBD1" TextWrapping="Wrap"/>
                </StackPanel>
                <Border BorderBrush="#36556A" BorderThickness="1" Background="#101E2D" CornerRadius="10" Padding="13">
                  <StackPanel Spacing="5">
                    <CheckBox x:Name="PhasewardCommunityUploadToggle" Content="Send boss observations to Nexforge"/>
                    <TextBlock x:Name="PhasewardCommunityUploadStatus" Classes="hint" Margin="25,0,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border BorderBrush="#36556A" BorderThickness="1" Background="#101E2D" CornerRadius="10" Padding="13">
                  <StackPanel Spacing="5">
                    <CheckBox x:Name="PhasewardTraceV2UploadToggle" Content="Share detailed boss research (V2)"/>
                    <TextBlock x:Name="PhasewardV2PrivacyBrief" Classes="hint" Margin="25,0,0,0" TextWrapping="Wrap"
                               Text="Raw packets may contain identifiers or location data. Separate consent required."/>
                    <TextBlock x:Name="PhasewardTraceV2UploadStatus" Classes="hint" Margin="25,0,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border x:Name="PhasewardAdvancedExpander" CornerRadius="12" BorderBrush="#31546D" BorderThickness="1" Background="#0D2032" ClipToBounds="True">
                  <StackPanel Spacing="0">
                    <!-- Own disclosure: avoids the default Fluent Expander black header and popup chrome. -->
                    <Button x:Name="PhasewardAdvancedDisclosure" Background="#10263A" BorderBrush="Transparent" BorderThickness="0"
                            Foreground="#E7F5FC" Padding="14,11" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock x:Name="PhasewardAdvancedTitle" Text="ADVANCED // RECORDING" FontSize="11" FontWeight="SemiBold" Foreground="#7BE1F5"/>
                          <TextBlock x:Name="PhasewardAdvancedSubtitle" Text="Local capture and queue tools" FontSize="11" Foreground="#9CB7C9" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="PhasewardAdvancedChevron" Text="⌄" FontSize="19" Foreground="#A9D8E9" VerticalAlignment="Center"/>
                      </Grid>
                    </Button>
                    <StackPanel x:Name="PhasewardAdvancedContent" IsVisible="False" Spacing="0" Margin="14,0,14,11">
                      <Border BorderBrush="#2D4F66" BorderThickness="0,1,0,0" Padding="0,11,0,11">
                        <StackPanel Spacing="5">
                          <TextBlock x:Name="PhasewardAdvancedLearningTag" Text="LOCAL ANALYSIS" FontSize="10" Foreground="#7599B3" FontWeight="SemiBold"/>
                          <CheckBox x:Name="PhasewardLearningToggle" Classes="phaseward-choice" Content="Local pattern recognition"/>
                          <TextBlock x:Name="PhasewardLearningStatusText" Margin="25,1,0,0" Foreground="#8DADBF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border BorderBrush="#2D4F66" BorderThickness="0,1,0,0" Padding="0,11,0,11">
                        <StackPanel Spacing="6">
                          <TextBlock x:Name="PhasewardAdvancedCaptureTag" Text="LOCAL CAPTURE" FontSize="10" Foreground="#7599B3" FontWeight="SemiBold"/>
                          <CheckBox x:Name="PhasewardDetailedTraceToggle" Classes="phaseward-choice" Content="Record detailed boss data"/>
                          <TextBlock x:Name="PhasewardAdvancedCaptureHelp" Text="Required for new Research V2 uploads" Margin="25,0,0,0" Foreground="#8DADBF" FontSize="11" TextWrapping="Wrap"/>
                          <Button x:Name="PhasewardTraceV2Clear" HorizontalAlignment="Left" Margin="25,0,0,0" Background="#102A40"
                                  BorderBrush="#31536D" BorderThickness="1" CornerRadius="7" Padding="10,5" Foreground="#BDDDEB" FontSize="11"
                                  Content="Delete queued Research V2 archives"/>
                        </StackPanel>
                      </Border>
                      <Border BorderBrush="#2D4F66" BorderThickness="0,1,0,0" Padding="0,11,0,11">
                        <StackPanel Spacing="6">
                          <TextBlock x:Name="PhasewardAdvancedQueueTag" Text="COMMUNITY QUEUE" FontSize="10" Foreground="#7599B3" FontWeight="SemiBold"/>
                          <CheckBox x:Name="PhasewardCommunityQueueToggle" Classes="phaseward-choice" Content="Prepare community observations"/>
                          <WrapPanel Margin="25,0,0,0" Orientation="Horizontal">
                            <TextBlock x:Name="PhasewardCommunityQueueStatus" Foreground="#8DADBF" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="PhasewardCommunityQueueClear" Background="#102A40" BorderBrush="#31536D" BorderThickness="1"
                                    CornerRadius="7" Padding="10,5" Foreground="#BDDDEB" FontSize="11"
                                    Content="Delete pending observations" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="PhasewardAdvancedDependencyInfo" Text="Server uploads enable required capture automatically. Turning uploads off may leave local recording enabled."
                                 Margin="1,0,1,9" FontSize="11" Foreground="#88B0C5" TextWrapping="Wrap"/>
                      <Button x:Name="PhasewardTechnicalDisclosure" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                              HorizontalAlignment="Left" Padding="0,5" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="ⓘ" Foreground="#72A5C1" FontSize="13"/>
                          <TextBlock x:Name="PhasewardAdvancedTechnicalTitle" Text="Technical information" Foreground="#93BDD4" FontSize="11"/>
                        </StackPanel>
                      </Button>
                      <StackPanel x:Name="PhasewardTechnicalContent" IsVisible="False" Spacing="8" Margin="4,6,0,2">
                        <TextBlock x:Name="PhasewardLearningHint" Classes="hint" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PhasewardCommunityUploadHint" Classes="hint" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PhasewardTraceV2UploadHint" Classes="hint" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PhasewardCommunityQueueHint" Classes="hint" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Overlay Studio" Classes="settings-label"/><TextBlock Text="Move and resize HUD overlays on the screen. Use DEMO mode to preview Phaseward mechanics before saving." Classes="hint" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="ui" Content="Open Studio" Click="OpenOverlayStudioClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings05Timers}" Classes="settings-index"/><TextBlock Text="{DynamicResource TimersCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource TimersCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource EventTimerRegionLabel}" Classes="settings-label"/><TextBlock Text="{DynamicResource EventTimerRegionHint}" Classes="hint"/></StackPanel><ComboBox x:Name="EventTimerRegionCombo" Grid.Column="1" Classes="settings-select"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource EventTimerOverlayTitle}" Classes="settings-label"/><TextBlock Text="{DynamicResource EventTimerOverlaySettingsHint}" Classes="hint"/><CheckBox x:Name="EventTimerClickThroughToggle" Content="{DynamicResource EventTimerClickThrough}"/></StackPanel><Button Grid.Column="1" Classes="ui" Content="{DynamicResource Open}" Click="OpenEventTimerOverlayClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings06DataUpdates}" Classes="settings-index"/><TextBlock Text="{DynamicResource ForgeDataCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource ForgeDataCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Ellipse x:Name="ForgeDataStatusDot" Width="8" Height="8" Fill="#58E0B2" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{DynamicResource ForgeDataRuntimeTitle}" Classes="settings-label"/><TextBlock x:Name="ForgeDataStatusText" Classes="hint"/><TextBlock x:Name="ForgeDataPathText" Classes="mono" FontSize="10" Foreground="#5F7488" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Border Grid.Column="2" Classes="settings-status" VerticalAlignment="Center"><TextBlock Text="{DynamicResource LocalDataBadge}" Classes="kicker" FontSize="9"/></Border>
              </Grid>
            </Border>
            <Border Classes="settings-row"><StackPanel Spacing="4"><CheckBox x:Name="AutoUpdateToggle" Content="{DynamicResource AutoUpdateToggle}"/><TextBlock Text="{DynamicResource AutoUpdateHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel></Border>
            <Border Classes="settings-row"><StackPanel Spacing="4"><CheckBox x:Name="BackgroundUpdateToggle" Content="{DynamicResource BackgroundUpdateToggle}"/><TextBlock Text="{DynamicResource BackgroundUpdateHint}" Classes="hint" Margin="25,0,0,0"/></StackPanel></Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="4">
                <CheckBox x:Name="IntegrityMonitoringToggle" Content="{DynamicResource IntegrityMonitoringToggle}"/>
                <TextBlock Text="{DynamicResource IntegrityMonitoringHint}" Classes="hint" Margin="25,0,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Ellipse x:Name="IntegrityStatusDot" Width="8" Height="8" Fill="#71879B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock x:Name="IntegrityStatusTitle" Classes="settings-label"/>
                  <TextBlock x:Name="IntegrityStatusText" Classes="hint" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="IntegrityCheckButton" Grid.Column="2" Classes="ui"
                        Content="{DynamicResource IntegrityCheckAgain}" Click="IntegrityCheckClick"
                        VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource CurrentVersion}" Classes="settings-label"/><TextBlock x:Name="UpdateCheckStatusText" Classes="hint" TextWrapping="Wrap"/></StackPanel><Button x:Name="CheckUpdateButton" Grid.Column="1" Classes="ui" Content="{DynamicResource CheckForUpdates}" Click="CheckUpdateClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings07Pets}" Classes="settings-index"/><TextBlock Text="{DynamicResource PetCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource PetCategoryHint}" Classes="hint"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="9">
            <Border Classes="settings-row"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource PetCollectionStatus}" Classes="settings-label"/><TextBlock Text="{DynamicResource PetStatusRuntimeHint}" Classes="hint"/></StackPanel><Border Grid.Column="1" Classes="settings-status" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="PetCollectionStatusDot" Width="7" Height="7" Fill="#FFB454" VerticalAlignment="Center"/><TextBlock x:Name="PetCollectionStatusText" Text="{DynamicResource PetUnknown}" FontSize="10" FontWeight="SemiBold" Foreground="#FFB454"/></StackPanel></Border></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="92,*" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource PetUnknown}" Classes="kicker" FontSize="9" Foreground="#FFB454"/><TextBlock Text="{DynamicResource PetUnknownTitle}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource PetUnknownText}" Classes="hint" VerticalAlignment="Center"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="92,*" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource PetPartial}" Classes="kicker" FontSize="9"/><TextBlock Text="{DynamicResource PetPartialTitle}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource PetPartialText}" Classes="hint" VerticalAlignment="Center"/></Grid></Border>
            <Border Classes="settings-row"><Grid ColumnDefinitions="92,*" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource PetReady}" Classes="kicker" FontSize="9" Foreground="#58E0B2"/><TextBlock Text="{DynamicResource PetReadyTitle}" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource PetReadyText}" Classes="hint" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="settings-card">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings08SupportLogs}" Classes="settings-index"/><TextBlock Text="{DynamicResource DiagnosticsCategory}" Classes="settings-category"/><TextBlock Text="{DynamicResource DiagnosticsCategoryHint}" Classes="hint"/></StackPanel>
          <Border Grid.Column="1" Classes="settings-row"><StackPanel Spacing="5"><CheckBox x:Name="FileLoggingToggle" Content="{DynamicResource LoggingToggle}"/><TextBlock x:Name="FileLoggingHint" Classes="hint" TextWrapping="Wrap" Margin="25,0,0,0"/></StackPanel></Border>
        </Grid>
      </Border>

      <Border x:Name="DeveloperSettingsPanel" Classes="settings-card" BorderBrush="#7045DFFF">
        <Grid ColumnDefinitions="164,*" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="{DynamicResource UiSettings09Debug}" Classes="settings-index"/><TextBlock Text="{DynamicResource DeveloperTools}" Classes="settings-category"/></StackPanel>
          <Border Grid.Column="1" Classes="settings-row"><StackPanel Spacing="4"><TextBlock Text="{DynamicResource DeveloperToolsHint}" Classes="body"/><TextBlock Text="{DynamicResource DeveloperModeActive}" Classes="kicker" FontSize="9"/></StackPanel></Border>
        </Grid>
      </Border>

      <Border Classes="settings-card" Padding="18,13">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="#45DFFF" VerticalAlignment="Center"/><TextBlock Text="NEXFORGE // COMPANION CONFIGURATION" Classes="kicker" FontSize="9"/></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource UnderForge}" Classes="mono" FontSize="9" Foreground="#8F7845"/></Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
